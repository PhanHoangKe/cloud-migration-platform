# =========================
# API Gateway HTTP API
# =========================
resource "aws_apigatewayv2_api" "migration_api" {
  name          = "${var.project_name}-api-${var.student_code}"
  protocol_type = "HTTP"

  cors_configuration {
    allow_headers = ["content-type", "authorization"]
    allow_methods = ["GET", "POST", "OPTIONS"]
    allow_origins = ["*"]
  }

  tags = {
    Name    = "${var.project_name}-api-${var.student_code}"
    Project = var.project_name
  }
}

# =========================
# API Gateway Integration with Lambda
# =========================
resource "aws_apigatewayv2_integration" "self_test_integration" {
  api_id                 = aws_apigatewayv2_api.migration_api.id
  integration_type       = "AWS_PROXY"
  integration_uri        = aws_lambda_function.migration_self_test.invoke_arn
  payload_format_version = "2.0"
}

# =========================
# Route: GET /self-test
# =========================
resource "aws_apigatewayv2_route" "self_test_route" {
  api_id    = aws_apigatewayv2_api.migration_api.id
  route_key = "GET /self-test"
  target    = "integrations/${aws_apigatewayv2_integration.self_test_integration.id}"
}

# =========================
# Default Stage
# =========================
resource "aws_apigatewayv2_stage" "default_stage" {
  api_id      = aws_apigatewayv2_api.migration_api.id
  name        = "$default"
  auto_deploy = true

  tags = {
    Name    = "${var.project_name}-default-stage-${var.student_code}"
    Project = var.project_name
  }
}

# =========================
# Lambda Permission for API Gateway
# =========================
resource "aws_lambda_permission" "allow_api_gateway" {
  statement_id  = "AllowAPIGatewayInvoke"
  action        = "lambda:InvokeFunction"
  function_name = aws_lambda_function.migration_self_test.function_name
  principal     = "apigateway.amazonaws.com"

  source_arn = "${aws_apigatewayv2_api.migration_api.execution_arn}/*/*"
}