@model MigrationDashboard.Models.RestoreResultViewModel
@{
    ViewData["Title"] = "Kết quả Mô phỏng Khôi phục sự cố";
}

<div class="container-fluid py-4">
    <!-- Top Result Banner -->
    <div class="row mb-4">
        <div class="col-12">
            @if (Model.RestoreStatus == "COMPLETED")
            {
                <div class="card bg-success bg-opacity-10 border border-success border-opacity-25 rounded-4 p-4 shadow-sm">
                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 56px; height: 56px; font-size: 28px; flex-shrink: 0;">
                            <i class="bi bi-shield-check"></i>
                        </div>
                        <div>
                            <h3 class="text-success font-bold mb-1" style="font-weight: 700;">Khôi phục sự cố hoàn tất (COMPLETED)!</h3>
                            <p class="text-secondary mb-0">Hệ thống đã xác thực và tải đầy đủ gói di trú (Migration Package) từ Amazon S3 của LocalStack về thư mục khôi phục local.</p>
                        </div>
                    </div>
                </div>
            }
            else if (Model.RestoreStatus == "WARNING")
            {
                <div class="card bg-warning bg-opacity-10 border border-warning border-opacity-25 rounded-4 p-4 shadow-sm">
                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-warning text-dark rounded-circle d-flex align-items-center justify-content-center" style="width: 56px; height: 56px; font-size: 28px; flex-shrink: 0;">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                        </div>
                        <div>
                            <h3 class="text-warning font-bold mb-1" style="font-weight: 700; color: #856404 !important;">Khôi phục hoàn thành kèm cảnh báo (WARNING)!</h3>
                            <p class="text-secondary mb-0">Tất cả tệp bắt buộc (Mã nguồn, Manifest, Đánh giá) đã được khôi phục, tuy nhiên một số tệp báo cáo tùy chọn bị thiếu.</p>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="card bg-danger bg-opacity-10 border border-danger border-opacity-25 rounded-4 p-4 shadow-sm">
                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-danger text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 56px; height: 56px; font-size: 28px; flex-shrink: 0;">
                            <i class="bi bi-x-octagon-fill"></i>
                        </div>
                        <div>
                            <h3 class="text-danger font-bold mb-1" style="font-weight: 700;">Khôi phục sự cố thất bại (FAILED)!</h3>
                            <p class="text-secondary mb-0">Gói di trú lưu trữ trên S3 không hợp lệ hoặc thiếu các tệp tin bắt buộc để khôi phục hệ thống.</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- System Error Box -->
    @if (!Model.IsSuccess && !string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="row mb-4">
            <div class="col-12">
                <div class="dashboard-card border-danger">
                    <div class="card-header-custom">
                        <h5 class="card-title-custom text-danger">
                            <i class="bi bi-exclamation-octagon-fill me-2"></i> Lỗi hệ thống trong mô phỏng khôi phục
                        </h5>
                    </div>
                    <div class="alert alert-danger font-monospace text-xs mb-3">
                        @Model.ErrorMessage
                    </div>
                    <div class="text-muted small">
                        <strong>Khuyến nghị xử lý sự cố:</strong>
                        <ul class="mb-0 mt-1">
                            <li>Xác minh LocalStack đang chạy tại <code class="text-dark">http://localhost:4566</code>.</li>
                            <li>Đảm bảo đã thực hiện ít nhất 1 lần di trú (Start Migration) thành công để khởi tạo thư mục và tệp trên S3.</li>
                            <li>Kiểm tra xem file <code class="text-dark">source-package.zip</code> và các file đi kèm có bị xóa khỏi S3 bucket hay không.</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Main Content Layout Grid -->
    <div class="row g-4 mb-4">
        <!-- Left Side: Summary and Checklist -->
        <div class="col-lg-6">
            <!-- Metadata Card -->
            <div class="dashboard-card mb-4">
                <div class="card-header-custom border-bottom pb-2 mb-3">
                    <h5 class="card-title-custom text-indigo">
                        <i class="bi bi-info-circle-fill"></i> Thông tin buổi khôi phục
                    </h5>
                    <span class="badge bg-indigo bg-opacity-10 text-indigo">Disaster Recovery (DR)</span>
                </div>

                <table class="table table-borderless align-middle mb-0 text-sm">
                    <tbody>
                        <tr>
                            <td class="text-muted py-2 w-40">Mã khôi phục (RestoreId):</td>
                            <td class="font-monospace text-dark font-semibold py-2">@Model.RestoreId</td>
                        </tr>
                        <tr>
                            <td class="text-muted py-2">Gói di trú nguồn (MigrationId):</td>
                            <td class="font-monospace text-dark font-semibold py-2">
                                @if (string.IsNullOrEmpty(Model.MigrationId))
                                {
                                    <span class="text-muted">Không xác định</span>
                                }
                                else
                                {
                                    <span>@Model.MigrationId</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <td class="text-muted py-2">Trạng thái DR:</td>
                            <td class="py-2">
                                @if (Model.RestoreStatus == "COMPLETED")
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success"><i class="bi bi-check-circle-fill me-1"></i> COMPLETED</span>
                                }
                                else if (Model.RestoreStatus == "WARNING")
                                {
                                    <span class="badge bg-warning bg-opacity-10 text-warning"><i class="bi bi-exclamation-triangle-fill me-1"></i> WARNING</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger"><i class="bi bi-x-octagon-fill me-1"></i> FAILED</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <td class="text-muted py-2">Thời gian phục hồi:</td>
                            <td class="text-dark font-semibold py-2">@Model.RestoredAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        </tr>
                        <tr>
                            <td class="text-muted py-2">S3 Bucket nguồn:</td>
                            <td class="font-monospace text-dark py-2">s3://@Model.SourceBucket/</td>
                        </tr>
                        <tr>
                            <td class="text-muted py-2">Thư mục khôi phục local:</td>
                            <td class="font-monospace text-dark py-2" style="font-size: 11px; word-break: break-all;">
                                @if (string.IsNullOrEmpty(Model.LocalRestorePath))
                                {
                                    <span class="text-muted">N/A</span>
                                }
                                else
                                {
                                    <span>wwwroot@Model.LocalRestorePath/</span>
                                }
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Validation Checklist -->
            <div class="dashboard-card">
                <div class="card-header-custom border-bottom pb-2 mb-3">
                    <h5 class="card-title-custom text-dark text-sm">
                        <i class="bi bi-check-square-fill text-success me-2"></i> Kết quả kiểm định tệp tin S3
                    </h5>
                    <span class="badge bg-success bg-opacity-10 text-success">Checklist</span>
                </div>

                <div class="d-flex flex-column gap-3">
                    @foreach (var val in Model.ValidationResults)
                    {
                        <div class="p-3 rounded-3 bg-light border d-flex align-items-start gap-3">
                            <div class="flex-shrink-0 mt-0.5">
                                @if (val.Status == "PASSED")
                                {
                                    <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                }
                                else if (val.Status == "WARNING")
                                {
                                    <i class="bi bi-exclamation-triangle-fill text-warning fs-5"></i>
                                }
                                else
                                {
                                    <i class="bi bi-x-circle-fill text-danger fs-5"></i>
                                }
                            </div>
                            <div class="flex-grow-1">
                                <div class="d-flex align-items-center justify-content-between">
                                    <strong class="text-sm text-dark">@val.CheckName</strong>
                                    <span class="badge bg-@(val.Status == "PASSED" ? "success" : (val.Status == "WARNING" ? "warning" : "danger")) bg-opacity-10 text-@(val.Status == "PASSED" ? "success" : (val.Status == "WARNING" ? "warning" : "danger"))" style="font-size: 9px;">@val.Status</span>
                                </div>
                                <p class="text-xs text-muted mb-0 mt-1">@val.Description</p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Right Side: Downloaded Files and Notes -->
        <div class="col-lg-6">
            <!-- Files S3 Status & Local Downloads -->
            <div class="dashboard-card mb-4">
                <div class="card-header-custom border-bottom pb-2 mb-3">
                    <h5 class="card-title-custom text-dark text-sm">
                        <i class="bi bi-cloud-arrow-down-fill text-indigo me-2"></i> Danh mục tệp tin & Trạng thái tải về
                    </h5>
                    <span class="badge bg-indigo bg-opacity-10 text-indigo">Chi tiết gói</span>
                </div>

                @if (Model.RestoredFiles.Any())
                {
                    <div class="d-flex flex-column gap-2.5">
                        @foreach (var file in Model.RestoredFiles)
                        {
                            <div class="p-3 rounded-3 bg-light border">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        @{
                                            string fileIcon = "bi-file-earmark-code text-indigo";
                                            if (file.FileName.EndsWith(".zip")) fileIcon = "bi-file-earmark-zip text-warning";
                                            else if (file.FileName.EndsWith(".html")) fileIcon = "bi-file-earmark-richtext text-danger";
                                        }
                                        <i class="bi @fileIcon fs-5"></i>
                                        <div>
                                            <span class="font-bold text-dark text-sm d-block">@file.FileName</span>
                                            <code class="text-xxs text-muted" style="font-size: 10px;">@file.S3Key</code>
                                        </div>
                                    </div>
                                    <div class="text-end">
                                        <span class="badge bg-@(file.ExistsOnS3 ? "success" : "danger") bg-opacity-10 text-@(file.ExistsOnS3 ? "success" : "danger") mb-1 d-inline-block" style="font-size: 9px;">
                                            S3: @(file.ExistsOnS3 ? "Có" : "Thiếu")
                                        </span>
                                    </div>
                                </div>

                                <div class="d-flex justify-content-between align-items-center pt-2 border-top border-secondary border-opacity-10 text-xs">
                                    <div class="text-muted">
                                        Kích thước: 
                                        <strong>
                                            @if (file.ExistsOnS3)
                                            {
                                                @((file.Size >= 1048576) ? $"{(file.Size / 1048576.0):F2} MB" : $"{(file.Size / 1024.0):F1} KB")
                                            }
                                            else
                                            {
                                                <span>0 KB</span>
                                            }
                                        </strong>
                                    </div>
                                    <div>
                                        @if (file.DownloadedLocally)
                                        {
                                            <a href="@file.LocalPath" target="_blank" class="badge bg-success bg-opacity-15 text-success border border-success border-opacity-25 py-1.5 px-2 rounded-2 text-decoration-none">
                                                <i class="bi bi-download me-1"></i> Tải cục bộ (Local)
                                            </a>
                                        }
                                        else
                                        {
                                            if (file.FileName == "source-package.zip" && file.Size >= 52428800)
                                            {
                                                <span class="badge bg-secondary bg-opacity-10 text-secondary py-1.5 px-2 rounded-2" data-bs-toggle="tooltip" title="Gói ZIP > 50MB được xác thực trên S3 nhưng bỏ qua tải xuống local để tiết kiệm tài nguyên">
                                                    <i class="bi bi-info-circle me-1"></i> Bỏ qua (ZIP > 50MB)
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger bg-opacity-10 text-danger py-1.5 px-2 rounded-2">
                                                    <i class="bi bi-x-circle me-1"></i> Không khả dụng
                                                </span>
                                            }
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-4">
                        <i class="bi bi-folder-x fs-3 d-block mb-2 text-secondary"></i>
                        Không có tệp tin nào để hiển thị.
                    </div>
                }
            </div>

            <!-- DR Simulation Academic Alert -->
            <div class="alert alert-warning border border-warning border-opacity-25 rounded-4 p-3.5 mb-0 shadow-sm" style="background-color: rgba(255, 193, 7, 0.05); color: #856404; font-size: 12px; line-height: 1.6;">
                <div class="d-flex gap-2">
                    <i class="bi bi-shield-fill-exclamation fs-4 text-warning flex-shrink-0"></i>
                    <div>
                        <strong class="text-dark">Lưu ý mô phỏng khôi phục thảm họa (Disaster Recovery Simulation)</strong><br>
                        Hệ thống mô phỏng phục hồi bằng cách tìm kiếm gói di trú mới nhất trên AWS S3, tải các tệp tin đánh giá cấu hình và báo cáo di trú về máy cục bộ. 
                        Để đảm bảo an toàn cho môi trường học thuật, <strong>không có dữ liệu thật nào ở cơ sở dữ liệu On-premise bị ghi đè</strong>. 
                        Đồng thời, đối với gói mã nguồn <code class="text-dark">source-package.zip</code> nếu có dung lượng lớn hơn 50MB, hệ thống chỉ kiểm tra sự tồn tại của nó trên AWS S3 mà không thực hiện tải xuống để tránh chiếm dụng băng thông và dung lượng đĩa của máy chủ.
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Execution Logs Console -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="dashboard-card">
                <div class="card-header-custom" data-bs-toggle="collapse" href="#collapseRestoreLogs" role="button" aria-expanded="true" aria-controls="collapseRestoreLogs" style="cursor: pointer;">
                    <h5 class="card-title-custom text-muted">
                        <i class="bi bi-terminal-fill me-2"></i> Nhật ký hoạt động khôi phục (DR Simulation Logs)
                    </h5>
                    <i class="bi bi-chevron-down text-muted fs-6"></i>
                </div>

                <div class="collapse show" id="collapseRestoreLogs">
                    <div class="console-box mt-3" style="max-height: 250px;">
                        @if (Model.Logs.Any())
                        {
                            @foreach (var log in Model.Logs)
                            {
                                <div class="console-line">
                                    <span class="text-muted">[@log.Timestamp]</span>
                                    @if (log.Status == "RESTORE_STARTED" || log.Status == "DOWNLOAD_STARTED" || log.Status == "S3_SCANNING")
                                    {
                                        <span class="c-info">[INFO]</span>
                                    }
                                    else if (log.Status == "RESTORE_PACKAGE_VALIDATED" || log.Status == "DOWNLOAD_SUCCESS" || log.Status == "RESTORE_COMPLETED" || log.Status == "SUMMARY_EXPORTED")
                                    {
                                        <span class="c-success">[SUCCESS]</span>
                                    }
                                    else if (log.Status == "RESTORE_WARNING" || log.Status == "DOWNLOAD_SKIPPED")
                                    {
                                        <span class="c-warning">[WARNING]</span>
                                    }
                                    else
                                    {
                                        <span class="c-warning">[@log.Status]</span>
                                    }
                                    <span class="text-white"> @log.Message</span>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-muted text-xs">Không có nhật ký phục hồi nào.</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Actions Section -->
    <div class="row">
        <div class="col-12 d-flex justify-content-center gap-3">
            <a href="/Assessment" class="btn btn-outline-secondary px-4 py-2" style="border-radius: 8px; font-weight: 600;">
                <i class="bi bi-clipboard2-check me-2"></i> Đánh giá On-Premise
            </a>
            
            <form asp-controller="Migration" asp-action="Start" method="post" id="migrationResultForm">
                <button type="submit" class="btn btn-warning px-4 py-2" style="border-radius: 8px; font-weight: 600; box-shadow: 0 4px 12px rgba(245, 158, 11, 0.2);">
                    <i class="bi bi-rocket-takeoff me-2"></i> Bắt đầu di trú mới
                </button>
            </form>

            <a href="/#dashboard" class="btn btn-primary px-4 py-2" style="border-radius: 8px; font-weight: 600; box-shadow: 0 4px 12px rgba(79, 70, 229, 0.2);">
                <i class="bi bi-speedometer2 me-2"></i> Quay lại Dashboard
            </a>
        </div>
    </div>
</div>
