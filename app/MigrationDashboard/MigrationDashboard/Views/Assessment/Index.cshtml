@model MigrationDashboard.Models.PreMigrationAssessmentViewModel
@{
    ViewData["Title"] = "Đánh giá trước chuyển đổi";
}

<!-- Section: TempData Alerts -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="row mb-4">
        <div class="col-12">
            <div class="alert alert-success border-success border-opacity-25 rounded-3 d-flex align-items-center justify-content-between p-3 mb-0 shadow-sm" role="alert">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-check-circle-fill text-success fs-5"></i>
                    <div>
                        <strong>Thành công!</strong> @TempData["SuccessMessage"]
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="row mb-4">
        <div class="col-12">
            <div class="alert alert-danger border-danger border-opacity-25 rounded-3 d-flex align-items-center justify-content-between p-3 mb-0 shadow-sm" role="alert">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-exclamation-octagon-fill text-danger fs-5"></i>
                    <div>
                        <strong>Thất bại!</strong> @TempData["ErrorMessage"]
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(Model.ScanError))
{
    <div class="row mb-4">
        <div class="col-12">
            <div class="alert alert-warning border-warning border-opacity-25 rounded-3 p-3 mb-0 shadow-sm" role="alert">
                <div class="d-flex align-items-start gap-2">
                    <i class="bi bi-exclamation-triangle-fill text-warning fs-5 mt-0.5"></i>
                    <div>
                        <strong>Cảnh báo phân tích mã nguồn:</strong>
                        <p class="mb-0 mt-1 small text-dark">@Model.ScanError</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Section Header -->
<div class="row mb-4">
    <div class="col-12 d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div>
            <h4 class="mb-1 font-bold text-dark"><i class="bi bi-clipboard2-check text-primary me-2"></i>Đánh giá trước chuyển đổi (Pre-Migration Assessment)</h4>
            <p class="text-muted small mb-0">Quét mã nguồn và cấu hình của ứng dụng On-premise để đánh giá mức độ sẵn sàng chuyển đổi lên AWS Cloud.</p>
        </div>
        <div class="d-flex gap-2">
            <form asp-controller="Assessment" asp-action="Run" method="post">
                <button type="submit" class="btn btn-outline-secondary" style="padding: 0.5rem 1.2rem; border-radius: 8px; font-weight: 600;">
                    <i class="bi bi-arrow-clockwise me-1"></i> Chạy đánh giá lại
                </button>
            </form>
            <form asp-controller="Migration" asp-action="Start" method="post">
                <button type="submit" class="btn btn-primary" style="padding: 0.5rem 1.5rem; border-radius: 8px; font-weight: 600; box-shadow: 0 4px 12px rgba(79, 70, 229, 0.25);">
                    <i class="bi bi-rocket-takeoff me-1"></i> Bắt đầu chuyển đổi
                </button>
            </form>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Left Column: Readiness Score & Source App Info -->
    <div class="col-lg-4">
        <!-- Readiness Score Card -->
        <div class="dashboard-card text-center d-flex flex-column align-items-center justify-content-center mb-4">
            <h6 class="text-uppercase tracking-wider text-muted font-semibold mb-3" style="font-size: 11px; letter-spacing: 1px;">ĐIỂM SẴN SÀNG (READINESS SCORE)</h6>
            
            <div class="mb-3">
                @if (Model.ReadinessScore >= 80)
                {
                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-1.5 rounded-pill" style="font-weight: 700; font-size: 11px;"><i class="bi bi-check-circle me-1"></i> Rất sẵn sàng</span>
                }
                else if (Model.ReadinessScore >= 50)
                {
                    <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-3 py-1.5 rounded-pill" style="font-weight: 700; font-size: 11px;"><i class="bi bi-exclamation-circle me-1"></i> Cần cấu hình thêm</span>
                }
                else
                {
                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-3 py-1.5 rounded-pill" style="font-weight: 700; font-size: 11px;"><i class="bi bi-x-circle me-1"></i> Chưa sẵn sàng</span>
                }
            </div>

            <div class="health-score-container mb-3">
                @{
                    string scoreColor = Model.ReadinessScore >= 80 ? "#10b981" : (Model.ReadinessScore >= 50 ? "#f59e0b" : "#ef4444");
                    double scoreDegrees = Model.ReadinessScore * 3.6;
                }
                <div class="health-circle-outer" style="background: conic-gradient(@scoreColor 0deg, @scoreColor @(scoreDegrees)deg, #e2e8f0 @(scoreDegrees)deg); width: 130px; height: 130px;">
                    <div class="health-circle-inner" style="width: 110px; height: 110px;">
                        <span class="health-value" style="font-size: 26px;">@Model.ReadinessScore%</span>
                        <span class="health-label">Sẵn sàng</span>
                    </div>
                </div>
            </div>

            <p class="text-muted small px-3">
                Điểm đánh giá dựa trên mức độ hoàn thiện kiến trúc mã nguồn .NET, loại cơ sở dữ liệu và cấu hình môi trường.
            </p>
        </div>

        <!-- Source App details -->
        <div class="dashboard-card">
            <div class="card-header-custom border-bottom pb-2 mb-3">
                <h5 class="card-title-custom text-dark text-sm">
                    <i class="bi bi-info-square text-indigo me-2"></i> Ứng dụng nguồn (On-premise)
                </h5>
            </div>
            
            <div class="d-flex flex-column gap-3">
                <div>
                    <span class="text-xs text-muted d-block uppercase" style="font-size: 10px; font-weight: 700;">Tên dự án</span>
                    <strong class="text-sm text-dark">@Model.ProjectName</strong>
                </div>
                <div>
                    <span class="text-xs text-muted d-block uppercase" style="font-size: 10px; font-weight: 700;">Chiến lược chuyển đổi đề xuất</span>
                    <span class="badge bg-indigo bg-opacity-10 text-indigo text-xs" style="font-weight: 600;">@Model.RecommendedMigrationStrategy</span>
                </div>
                <div>
                    <span class="text-xs text-muted d-block uppercase" style="font-size: 10px; font-weight: 700;">Đường dẫn thư mục quét</span>
                    <code class="text-xs text-muted d-block text-truncate" style="max-width: 100%;" title="@Model.OnPremAppPath">@Model.OnPremAppPath</code>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column: Metrics, Risks & Recommendations -->
    <div class="col-lg-8">
        <!-- Metrics Grid -->
        <div class="row g-3 mb-4">
            @foreach (var metric in Model.Metrics)
            {
                <div class="col-sm-6 col-md-4">
                    <div class="dashboard-card p-3 d-flex align-items-center gap-3">
                        @{
                            string iconBg = metric.Status == "Success" ? "success" : (metric.Status == "Warning" ? "warning" : "info");
                        }
                        <div class="stat-icon @iconBg" style="width: 40px; height: 40px; font-size: 18px; border-radius: 8px;">
                            <i class="bi @metric.Icon"></i>
                        </div>
                        <div>
                            <div class="text-muted text-xxs" style="font-size: 10px;">@metric.Name</div>
                            <div class="font-bold text-dark text-sm">@metric.Value</div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Risk Items -->
        <div class="dashboard-card mb-4">
            <div class="card-header-custom border-bottom pb-2 mb-3">
                <h5 class="card-title-custom text-danger">
                    <i class="bi bi-shield-slash-fill me-2"></i> Rủi ro được phát hiện (Risks Detected)
                </h5>
                <span class="status-badge danger">@Model.RiskItems.Count rủi ro</span>
            </div>

            @if (Model.RiskItems.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 text-sm">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 15%;">Mức độ</th>
                                <th style="width: 45%;">Mô tả rủi ro</th>
                                <th style="width: 40%;">Khuyến nghị khắc phục</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var risk in Model.RiskItems)
                            {
                                string levelClass = risk.Level == "High" ? "danger" : (risk.Level == "Medium" ? "warning" : "info");
                                string levelText = risk.Level == "High" ? "Cao" : (risk.Level == "Medium" ? "Trung bình" : "Thấp");
                                <tr>
                                    <td>
                                        <span class="status-badge @levelClass">@levelText</span>
                                    </td>
                                    <td class="text-dark font-semibold text-xs">@risk.Description</td>
                                    <td class="text-muted text-xs">@risk.Recommendation</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center text-muted py-4">
                    <i class="bi bi-shield-check text-success fs-2 mb-2"></i>
                    <p class="mb-0 text-sm">Tuyệt vời! Không phát hiện rủi ro nghiêm trọng nào ngăn cản quá trình chuyển đổi.</p>
                </div>
            }
        </div>

        <!-- Recommendations -->
        <div class="dashboard-card mb-4">
            <div class="card-header-custom border-bottom pb-2 mb-3">
                <h5 class="card-title-custom text-success">
                    <i class="bi bi-lightbulb-fill me-2"></i> Lộ trình & Khuyến nghị đề xuất (Recommendations)
                </h5>
            </div>

            <ul class="list-group list-group-flush text-sm text-dark">
                @foreach (var rec in Model.Recommendations)
                {
                    <li class="list-group-item bg-transparent border-0 px-0 py-2 d-flex align-items-start gap-2">
                        <i class="bi bi-check2-circle text-success fs-5 mt-0.5" style="line-height: 1;"></i>
                        <div class="text-dark font-semibold">@rec</div>
                    </li>
                }
            </ul>
        </div>

        <!-- FinOps Cost Comparison Card -->
        <div class="dashboard-card">
            <div class="card-header-custom border-bottom pb-2 mb-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
                <h5 class="card-title-custom text-indigo">
                    <i class="bi bi-currency-dollar me-2"></i> Ước tính chi phí vận hành hàng tháng (FinOps Cost Analysis)
                </h5>
                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2.5 py-1 rounded-pill" style="font-weight: 700; font-size: 11px;">
                    <i class="bi bi-piggy-bank me-1"></i> Tiết kiệm @Model.CostSavingsPercent%
                </span>
            </div>

            <p class="text-muted small mb-4">
                Bảng so sánh chi phí ước tính hàng tháng giữa mô hình di chuyển nguyên trạng (Rehost - EC2 & RDS) và mô hình hiện đại hóa (Serverless - Lambda & DynamoDB) thiết kế riêng cho ứng dụng của bạn.
            </p>

            <div class="row g-3 mb-4">
                <!-- Rehost Cost Card -->
                <div class="col-md-6">
                    <div class="p-3 border rounded-3 text-center" style="background-color: rgba(239, 68, 68, 0.02); border-color: rgba(239, 68, 68, 0.1) !important;">
                        <h6 class="text-muted font-bold text-xs uppercase mb-1">Mô hình truyền thống (Rehost)</h6>
                        <span class="badge bg-danger bg-opacity-10 text-danger text-xxs mb-2" style="font-weight: 600;">EC2 + RDS SQL Server</span>
                        <h3 class="text-danger font-bold mb-1">$@Model.RehostTotalCost.ToString("F2")<span class="text-xs text-muted font-normal">/tháng</span></h3>
                        <p class="text-muted text-xxs mb-0">Thanh toán cố định hàng tháng dù không sử dụng hết tài nguyên.</p>
                    </div>
                </div>

                <!-- Serverless Cost Card -->
                <div class="col-md-6">
                    <div class="p-3 border rounded-3 text-center" style="background-color: rgba(16, 185, 129, 0.02); border-color: rgba(16, 185, 129, 0.15) !important; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.05);">
                        <h6 class="text-muted font-bold text-xs uppercase mb-1">Mô hình hiện đại hóa (Serverless)</h6>
                        <span class="badge bg-success bg-opacity-10 text-success text-xxs mb-2" style="font-weight: 600;">Lambda + DynamoDB + S3</span>
                        <h3 class="text-success font-bold mb-1">$@Model.ServerlessTotalCost.ToString("F2")<span class="text-xs text-muted font-normal">/tháng</span></h3>
                        <p class="text-muted text-xxs mb-0">Thanh toán theo lưu lượng thực tế (Pay-per-request), tối ưu hóa 100%.</p>
                    </div>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 text-sm">
                    <thead class="table-light">
                        <tr class="text-xs text-muted font-bold text-uppercase">
                            <th>Hạng mục chi phí</th>
                            <th class="text-center">Rehost (EC2 + RDS)</th>
                            <th class="text-center">Serverless (Lambda + S3)</th>
                            <th>Mô tả chi tiết</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="font-semibold text-dark text-xs">Phân hệ Web / Compute</td>
                            <td class="text-center text-danger font-semibold text-xs">$@Model.RehostWebCost.ToString("F2")</td>
                            <td class="text-center text-success font-semibold text-xs">$@Model.ServerlessWebCost.ToString("F2")</td>
                            <td class="text-muted text-xxs">EC2 t3.medium ($35) vs AWS Lambda ($0.12/controller)</td>
                        </tr>
                        <tr>
                            <td class="font-semibold text-dark text-xs">Phân hệ Cơ sở dữ liệu</td>
                            <td class="text-center text-danger font-semibold text-xs">$@Model.RehostDbCost.ToString("F2")</td>
                            <td class="text-center text-success font-semibold text-xs">$@Model.ServerlessDbCost.ToString("F2")</td>
                            <td class="text-muted text-xxs">RDS SQL Server ($65) vs DynamoDB On-Demand ($0.08/MB logs)</td>
                        </tr>
                        <tr>
                            <td class="font-semibold text-dark text-xs">Lưu trữ file & Assets</td>
                            <td class="text-center text-danger font-semibold text-xs">$@Model.RehostStorageCost.ToString("F2")</td>
                            <td class="text-center text-success font-semibold text-xs">$@Model.ServerlessStorageCost.ToString("F2")</td>
                            <td class="text-muted text-xxs">EBS Storage ($10) vs AWS S3 Object Storage ($0.01/file)</td>
                        </tr>
                        <tr class="table-light font-bold">
                            <td class="text-dark text-xs">Tổng chi phí dự kiến</td>
                            <td class="text-center text-danger text-xs">$@Model.RehostTotalCost.ToString("F2")</td>
                            <td class="text-center text-success text-xs">$@Model.ServerlessTotalCost.ToString("F2")</td>
                            <td class="text-indigo text-xxs">Tiết kiệm khoảng $@((Model.RehostTotalCost - Model.ServerlessTotalCost).ToString("F2")) mỗi tháng</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
