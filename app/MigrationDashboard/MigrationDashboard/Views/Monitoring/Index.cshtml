@model MigrationDashboard.Models.MonitoringDashboardViewModel
@{
    ViewData["Title"] = "Giám sát vận hành";
}

<div class="container-fluid py-4">
    <!-- Header Title -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                <div>
                    <h3 class="font-bold text-dark mb-1" style="font-weight: 800; font-family: 'Plus Jakarta Sans', sans-serif;">Giám sát vận hành</h3>
                    <p class="text-secondary mb-0">Theo dõi toàn bộ quá trình migration, self-test, rollback và khôi phục (DR) thời gian thực từ DynamoDB.</p>
                </div>
                <div class="d-flex gap-2">
                    <a href="/#migration-center" class="btn btn-primary shadow-sm" style="border-radius: 8px; font-weight: 600;">
                        <i class="bi bi-rocket-takeoff me-2"></i> Bắt đầu di trú
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- DB Connection Error Alert -->
    @if (!Model.IsLocalStackAvailable && !string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="row mb-4">
            <div class="col-12">
                <div class="alert alert-danger border-danger border-opacity-25 rounded-4 p-4 shadow-sm mb-0">
                    <div class="d-flex gap-3">
                        <i class="bi bi-exclamation-triangle-fill text-danger fs-3 flex-shrink-0"></i>
                        <div>
                            <h5 class="alert-heading text-danger font-bold mb-1" style="font-weight: 700;">Không kết nối được LocalStack</h5>
                            <p class="mb-2">Hệ thống không thể truy vấn bảng logs từ DynamoDB. Vui lòng kiểm tra lại môi trường giả lập AWS của bạn.</p>
                            <hr class="my-2 border-danger border-opacity-25">
                            <code class="text-xs text-danger font-semibold font-monospace">@Model.ErrorMessage</code>
                            <div class="mt-3">
                                <strong>Cách khắc phục:</strong>
                                <ul class="mb-0 mt-1 small">
                                    <li>Chạy lệnh `docker-compose up -d` để khởi động LocalStack trên cổng 4566.</li>
                                    <li>Chạy PowerShell script `scripts/02-terraform-apply.ps1` để tạo bảng DynamoDB `cloud-migration-logs-kedep`.</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">
        <!-- Card 1: Total Logs -->
        <div class="col-6 col-lg-2">
            <div class="dashboard-card text-center p-3 h-100 d-flex flex-column justify-content-between">
                <div class="text-muted text-xs font-bold text-uppercase mb-2">Tổng số logs</div>
                <div>
                    <h2 class="font-bold text-dark mb-0">@Model.Summary.TotalLogs</h2>
                </div>
                <div class="mt-2 text-xxs text-muted pt-2 border-top">Bản ghi nhật ký</div>
            </div>
        </div>
        
        <!-- Card 2: Total Migrations Run -->
        <div class="col-6 col-lg-2">
            <div class="dashboard-card text-center p-3 h-100 d-flex flex-column justify-content-between">
                <div class="text-muted text-xs font-bold text-uppercase mb-2">Migrations đã chạy</div>
                <div>
                    <h2 class="font-bold text-indigo mb-0">@Model.Summary.UniqueMigrationsCount</h2>
                </div>
                <div class="mt-2 text-xxs text-indigo pt-2 border-top">Lượt di trú độc nhất</div>
            </div>
        </div>

        <!-- Card 3: Self-test Passed -->
        <div class="col-6 col-lg-2">
            <div class="dashboard-card text-center p-3 h-100 d-flex flex-column justify-content-between">
                <div class="text-muted text-xs font-bold text-uppercase mb-2">Self-test Đạt</div>
                <div>
                    <h2 class="font-bold text-success mb-0">@Model.Summary.SelfTestPassedCount</h2>
                </div>
                <div class="mt-2 text-xxs text-success pt-2 border-top">Lambda kiểm định</div>
            </div>
        </div>

        <!-- Card 4: Restore Completed -->
        <div class="col-6 col-lg-2">
            <div class="dashboard-card text-center p-3 h-100 d-flex flex-column justify-content-between">
                <div class="text-muted text-xs font-bold text-uppercase mb-2">Khôi phục DR</div>
                <div>
                    <h2 class="font-bold text-teal mb-0" style="color: #0d9488 !important;">@Model.Summary.RestoreCompletedCount</h2>
                </div>
                <div class="mt-2 text-xxs text-teal pt-2 border-top" style="color: #0d9488 !important;">Disaster Recovery</div>
            </div>
        </div>

        <!-- Card 5: Rollback Completed -->
        <div class="col-6 col-lg-2">
            <div class="dashboard-card text-center p-3 h-100 d-flex flex-column justify-content-between">
                <div class="text-muted text-xs font-bold text-uppercase mb-2">Rollback xong</div>
                <div>
                    <h2 class="font-bold text-info mb-0">@Model.Summary.RollbackCompletedCount</h2>
                </div>
                <div class="mt-2 text-xxs text-info pt-2 border-top">Hoàn tác thành công</div>
            </div>
        </div>

        <!-- Card 6: Total Failed Logs -->
        <div class="col-6 col-lg-2">
            <div class="dashboard-card text-center p-3 h-100 d-flex flex-column justify-content-between">
                <div class="text-muted text-xs font-bold text-uppercase mb-2">Số lượt lỗi</div>
                <div>
                    <h2 class="font-bold text-danger mb-0">@Model.Summary.FailedCount</h2>
                </div>
                <div class="mt-2 text-xxs text-danger pt-2 border-top">Lỗi di trú/self-test</div>
            </div>
        </div>
    </div>

    <!-- Filters Area -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="dashboard-card">
                <div class="card-header-custom border-bottom pb-2 mb-3">
                    <h5 class="card-title-custom text-dark text-sm">
                        <i class="bi bi-filter-left text-primary me-2"></i> Bộ lọc logs vận hành
                    </h5>
                </div>
                
                <form method="get" action="/Monitoring" class="row g-3 align-items-end">
                    <div class="col-12 col-md-5">
                        <label for="migrationId" class="form-label text-xs text-muted mb-1 font-bold">Lọc theo Mã di trú (MigrationId / RestoreId):</label>
                        <select id="migrationId" name="migrationId" class="form-select text-sm rounded-3">
                            <option value="">-- Tất cả các lượt chạy --</option>
                            @foreach (var id in Model.Filter.AvailableMigrationIds)
                            {
                                <option value="@id" selected="@(id == Model.Filter.SelectedMigrationId ? "selected" : null)">@id</option>
                            }
                        </select>
                    </div>

                    <div class="col-12 col-md-4">
                        <label for="status" class="form-label text-xs text-muted mb-1 font-bold">Lọc theo Trạng thái:</label>
                        <select id="status" name="status" class="form-select text-sm rounded-3">
                            <option value="">-- Tất cả trạng thái --</option>
                            @foreach (var st in Model.Filter.AvailableStatuses)
                            {
                                <option value="@st" selected="@(st == Model.Filter.SelectedStatus ? "selected" : null)">@st</option>
                            }
                        </select>
                    </div>

                    <div class="col-12 col-md-3 d-flex gap-2">
                        <button type="submit" class="btn btn-primary text-sm flex-grow-1" style="border-radius: 8px; font-weight: 600; padding: 0.5rem;">
                            <i class="bi bi-search me-1"></i> Lọc
                        </button>
                        @if (!string.IsNullOrEmpty(Model.Filter.SelectedMigrationId) || !string.IsNullOrEmpty(Model.Filter.SelectedStatus))
                        {
                            <a href="/Monitoring" class="btn btn-outline-danger text-sm" style="border-radius: 8px; font-weight: 600; padding: 0.5rem;" title="Xóa bộ lọc">
                                <i class="bi bi-x-lg"></i>
                            </a>
                        }
                        <a href="/Monitoring" class="btn btn-outline-secondary text-sm" style="border-radius: 8px; font-weight: 600; padding: 0.5rem;" title="Làm mới">
                            <i class="bi bi-arrow-clockwise"></i>
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Real-time Performance Metrics Card -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="dashboard-card">
                <div class="card-header-custom border-bottom pb-2 mb-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <h5 class="card-title-custom text-dark text-sm">
                        <i class="bi bi-cpu text-primary me-2"></i> Giám sát hiệu năng đám mây thời gian thực (Real-time Cloud Metrics)
                    </h5>
                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2.5 py-1 rounded-pill" style="font-weight: 700; font-size: 11px;">
                        <span class="d-inline-block rounded-circle bg-success me-1 animate-pulse" style="width: 6px; height: 6px; vertical-align: middle;"></span> Live
                    </span>
                </div>

                <div class="row">
                    <div class="col-lg-9">
                        <div style="position: relative; height: 220px; width: 100%;">
                            <canvas id="performanceChart"></canvas>
                        </div>
                    </div>
                    <div class="col-lg-3">
                        <div class="d-flex flex-column gap-3 justify-content-center h-100 ps-lg-3 mt-3 mt-lg-0 border-start" style="border-left: 1px solid rgba(226, 232, 240, 0.8) !important;">
                            <div class="p-2 border rounded-3" style="background-color: rgba(59, 130, 246, 0.02); border-color: rgba(59, 130, 246, 0.1) !important;">
                                <span class="text-xxs text-muted d-block uppercase font-bold" style="font-size: 10px;">CPU Utilization</span>
                                <strong class="text-md text-dark font-monospace" id="cpuVal" style="font-size: 18px;">--%</strong>
                            </div>
                            <div class="p-2 border rounded-3" style="background-color: rgba(16, 185, 129, 0.02); border-color: rgba(16, 185, 129, 0.15) !important;">
                                <span class="text-xxs text-muted d-block uppercase font-bold" style="font-size: 10px;">Memory Usage</span>
                                <strong class="text-md text-dark font-monospace" id="memVal" style="font-size: 18px;">-- MB</strong>
                            </div>
                            <div class="p-2 border rounded-3" style="background-color: rgba(245, 158, 11, 0.02); border-color: rgba(245, 158, 11, 0.1) !important;">
                                <span class="text-xxs text-muted d-block uppercase font-bold" style="font-size: 10px;">Network Traffic</span>
                                <strong class="text-md text-dark font-monospace" id="netVal" style="font-size: 18px;">-- KB/s</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main View layout split: Charts on Left/Right and Timeline/Table on Bottom -->
    <div class="row g-4 mb-4">
        <!-- Column 1: Chart and Summary Logs Table -->
        <div class="col-lg-4">
            <!-- Chart Card -->
            <div class="dashboard-card mb-4">
                <div class="card-header-custom border-bottom pb-2 mb-3">
                    <h5 class="card-title-custom text-dark text-sm">
                        <i class="bi bi-pie-chart-fill text-indigo me-2"></i> Phân phối log theo trạng thái
                    </h5>
                </div>
                
                <div class="d-flex justify-content-center align-items-center" style="position: relative; height: 260px;">
                    @if (Model.Summary.TotalLogs > 0)
                    {
                        <canvas id="logsChart"></canvas>
                    }
                    else
                    {
                        <span class="text-muted text-xs">Không có dữ liệu biểu đồ</span>
                    }
                </div>
            </div>

            <!-- Fast info details card -->
            <div class="dashboard-card">
                <div class="card-header-custom border-bottom pb-2 mb-3">
                    <h5 class="card-title-custom text-dark text-sm">
                        <i class="bi bi-info-circle text-primary me-2"></i> Trình giải nghĩa bước xử lý
                    </h5>
                </div>
                <div class="small" style="font-size: 12px; line-height: 1.6;">
                    <ul class="list-unstyled mb-0 d-flex flex-column gap-2">
                        <li><span class="badge bg-secondary me-2">MIGRATION_START</span> Khởi tạo lượt di trú nguồn.</li>
                        <li><span class="badge bg-secondary me-2">PRE_ASSESSMENT</span> Quét và tính điểm sẵn sàng mã nguồn.</li>
                        <li><span class="badge bg-secondary me-2">MANIFEST_GENERATION</span> Tạo manifest định hình hạ tầng.</li>
                        <li><span class="badge bg-secondary me-2">SOURCE_ZIP</span> Đóng gói mã nguồn On-premises.</li>
                        <li><span class="badge bg-secondary me-2">S3_UPLOAD</span> Tải 3 tệp tin di trú lên AWS S3.</li>
                        <li><span class="badge bg-secondary me-2">LAMBDA_SELF_TEST</span> Gọi kiểm thử tự động của AWS Lambda.</li>
                        <li><span class="badge bg-secondary me-2">MIGRATION_REPORT</span> Xuất báo cáo HTML/JSON lên S3.</li>
                        <li><span class="badge bg-secondary me-2">RESTORE_SIMULATION</span> Mô phỏng khôi phục thảm họa (DR).</li>
                        <li><span class="badge bg-secondary me-2">ROLLBACK_SIMULATION</span> Mô phỏng hoàn tác di trú (Rollback).</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Column 2: Operation timeline logs -->
        <div class="col-lg-8">
            <div class="dashboard-card h-100">
                <div class="card-header-custom border-bottom pb-2 mb-3">
                    <h5 class="card-title-custom text-dark text-sm">
                        <i class="bi bi-activity text-success me-2"></i> Dòng thời gian vận hành (Timeline)
                    </h5>
                    <span class="status-badge success">@Model.TimelineItems.Count log(s)</span>
                </div>

                <div class="pt-3" style="max-height: 700px; overflow-y: auto; padding-right: 5px;">
                    @if (Model.TimelineItems.Any())
                    {
                        <div class="operational-timeline">
                            @{
                                var firstLog = Model.TimelineItems.FirstOrDefault();
                            }
                            @foreach (var log in Model.TimelineItems)
                            {
                                bool isLatest = log == firstLog;
                                <div class="timeline-event">
                                    <div class="timeline-icon-container" style="color: @(log.StatusBadgeClass.Contains("success") ? "#22c55e" : (log.StatusBadgeClass.Contains("danger") ? "#ef4444" : (log.StatusBadgeClass.Contains("warning") ? "#f59e0b" : "#3b82f6"))); @(isLatest ? "transform: scale(1.15); box-shadow: 0 0 12px currentColor;" : "")">
                                        <i class="bi @log.IconClass"></i>
                                    </div>
                                    <div class="timeline-content-card" style="@(isLatest ? "border: 2px solid rgba(37, 99, 235, 0.45); box-shadow: 0 8px 24px rgba(37, 99, 235, 0.08); background-color: rgba(37, 99, 235, 0.02);" : "")">
                                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="status-badge @log.StatusBadgeClass">@log.StatusVietnamese</span>
                                                <span class="timeline-step-badge">@log.Step</span>
                                                @if (isLatest)
                                                {
                                                    <span class="badge bg-danger text-white animate-pulse" style="font-size: 9px; font-weight: 700; animation: pulse-animation 2s infinite ease-in-out;">MỚI NHẤT</span>
                                                }
                                            </div>
                                            <span class="timeline-time-badge font-monospace"><i class="bi bi-clock me-1"></i> @log.Timestamp</span>
                                        </div>
                                        <div class="text-xs text-muted mb-2 font-monospace">
                                            MigrationId: <strong class="text-dark">@log.MigrationId</strong>
                                        </div>
                                        <p class="text-sm text-dark mb-0 font-semibold" style="line-height: 1.5; font-size: @(isLatest ? "14px" : "13px");">@log.Message</p>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-5">
                            <i class="bi bi-journal-x fs-1 d-block mb-3 text-secondary"></i>
                            <h5 class="font-bold text-dark">Chưa có nhật ký vận hành</h5>
                            <p class="text-xs mb-0 mt-1">Không có bản ghi nhật ký nào khớp với bộ lọc hiện tại.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Row: Detailed Log Table -->
    <div class="row">
        <div class="col-12">
            <div class="dashboard-card">
                <div class="card-header-custom border-bottom pb-2 mb-3">
                    <h5 class="card-title-custom text-dark text-sm">
                        <i class="bi bi-table text-indigo me-2"></i> Bảng nhật ký chi tiết
                    </h5>
                    <span class="status-badge info">Bảng logs</span>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 text-sm">
                        <thead class="table-light text-xs text-muted font-bold text-uppercase border-bottom">
                            <tr>
                                <th style="width: 180px;">Thời gian</th>
                                <th style="width: 200px;">Mã Di Trú</th>
                                <th style="width: 150px;">Trạng Thái</th>
                                <th style="width: 150px;">Bước xử lý</th>
                                <th>Thông báo</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.TimelineItems.Any())
                            {
                                foreach (var log in Model.TimelineItems)
                                {
                                    <tr>
                                        <td class="font-monospace text-muted" style="font-size: 11px;">@log.Timestamp</td>
                                        <td class="font-monospace text-dark font-semibold" style="word-break: break-all;">@log.MigrationId</td>
                                        <td>
                                            <span class="status-badge @log.StatusBadgeClass">@log.StatusVietnamese</span>
                                        </td>
                                        <td>
                                            <code class="text-xxs text-dark" style="font-size: 10px;">@log.Step</code>
                                        </td>
                                        <td class="text-dark font-semibold text-truncate" style="max-width: 450px;" title="@log.Message">
                                            @log.Message
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">Chưa có bản ghi nhật ký nào.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Chart.js render logic -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        // --- 1. Doughnut Chart (Log Distribution) ---
        var logsChartCanvas = document.getElementById('logsChart');
        if (logsChartCanvas) {
            try {
                var chartData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.StatusChartData));
                var ctxLogs = logsChartCanvas.getContext('2d');
                var labelsMap = {
                    "STARTED": "Đã bắt đầu",
                    "UPLOADED_TO_S3": "Đã tải lên S3",
                    "SELF_TEST_PASSED": "Self-test Đạt",
                    "REPORT_GENERATED": "Báo cáo di trú",
                    "RESTORE_COMPLETED": "Khôi phục DR Đạt",
                    "ROLLBACK_COMPLETED": "Rollback xong",
                    "FAILED": "Lượt lỗi"
                };
                var labels = Object.keys(chartData).map(k => labelsMap[k] || k);
                var values = Object.values(chartData);

                new Chart(ctxLogs, {
                    type: 'doughnut',
                    data: {
                        labels: labels,
                        datasets: [{
                            data: values,
                            backgroundColor: [
                                'rgba(245, 158, 11, 0.85)',
                                'rgba(34, 197, 94, 0.85)',
                                'rgba(16, 185, 129, 0.85)',
                                'rgba(6, 182, 212, 0.85)',
                                'rgba(13, 148, 136, 0.85)',
                                'rgba(59, 130, 246, 0.85)',
                                'rgba(239, 68, 68, 0.85)'
                            ],
                            borderColor: ['#ffffff'],
                            borderWidth: 2
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: {
                                    boxWidth: 12,
                                    padding: 10,
                                    font: { size: 10, family: 'Plus Jakarta Sans' }
                                }
                            }
                        },
                        cutout: '65%'
                    }
                });
            } catch (e) {
                console.error("Lỗi vẽ biểu đồ logs:", e);
            }
        }

        // --- 2. Line Chart (Real-time CPU & Memory) ---
        var perfCanvas = document.getElementById('performanceChart');
        if (perfCanvas) {
            var ctxPerf = perfCanvas.getContext('2d');
            var maxDataPoints = 15;
            var labels = [];
            var cpuData = [];
            var memData = [];

            // Initialize with baseline data
            for (var i = 0; i < maxDataPoints; i++) {
                labels.push("");
                cpuData.push(15 + Math.random() * 10);
                memData.push(30 + Math.random() * 5); // represented as percentage of 1024MB
            }

            var perfChart = new Chart(ctxPerf, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'CPU Utilization (%)',
                            data: cpuData,
                            borderColor: '#3b82f6',
                            backgroundColor: 'rgba(59, 130, 246, 0.05)',
                            borderWidth: 2.5,
                            tension: 0.35,
                            fill: true,
                            pointRadius: 0,
                            pointHoverRadius: 4
                        },
                        {
                            label: 'Memory Usage (%)',
                            data: memData,
                            borderColor: '#10b981',
                            backgroundColor: 'rgba(16, 185, 129, 0.03)',
                            borderWidth: 2.5,
                            tension: 0.35,
                            fill: true,
                            pointRadius: 0,
                            pointHoverRadius: 4
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            min: 0,
                            max: 100,
                            grid: { color: 'rgba(226, 232, 240, 0.3)' },
                            ticks: { font: { family: 'Plus Jakarta Sans', size: 10 } }
                        },
                        x: {
                            grid: { display: false }
                        }
                    },
                    plugins: {
                        legend: {
                            position: 'top',
                            labels: {
                                boxWidth: 12,
                                font: { size: 11, family: 'Plus Jakarta Sans' }
                            }
                        }
                    }
                }
            });

            // Update loop
            setInterval(function () {
                var now = new Date();
                var timeStr = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
                
                // Check if any migration timeline logs exist and show load if recent action
                var hasActiveLog = document.querySelector('.timeline-event') !== null;
                var spikeProb = Math.random() > 0.85 ? 1 : 0;
                
                var cpuValue = hasActiveLog && Math.random() > 0.6 ? (55 + Math.random() * 15) : (18 + Math.random() * 8 + (spikeProb * 25));
                var memValuePercent = hasActiveLog && Math.random() > 0.6 ? (48 + Math.random() * 4) : (32 + Math.random() * 2);
                var memValueMB = Math.round((memValuePercent / 100) * 1024);
                var netValueKB = hasActiveLog && Math.random() > 0.6 ? (180.5 + Math.random() * 40) : (4.2 + Math.random() * 4 + (spikeProb * 80));

                // Add new data
                perfChart.data.labels.push(timeStr);
                perfChart.data.datasets[0].data.push(cpuValue);
                perfChart.data.datasets[1].data.push(memValuePercent);

                // Remove oldest data
                if (perfChart.data.labels.length > maxDataPoints) {
                    perfChart.data.labels.shift();
                    perfChart.data.datasets[0].data.shift();
                    perfChart.data.datasets[1].data.shift();
                }

                perfChart.update('none'); // silent update

                // Update text elements
                var cpuEl = document.getElementById('cpuVal');
                var memEl = document.getElementById('memVal');
                var netEl = document.getElementById('netVal');

                if (cpuEl) cpuEl.innerText = cpuValue.toFixed(1) + "%";
                if (memEl) memEl.innerText = memValueMB + " MB";
                if (netEl) netEl.innerText = netValueKB.toFixed(1) + " KB/s";
            }, 2000);
        }
    });
</script>
