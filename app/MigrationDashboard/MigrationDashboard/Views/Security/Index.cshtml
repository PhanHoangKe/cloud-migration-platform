@model MigrationDashboard.Models.SecurityComplianceDashboardViewModel
@{
    ViewData["Title"] = "Bảo mật & Tuân thủ";
}

<div class="container-fluid py-4">
    <!-- Header Title -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                <div>
                    <h3 class="font-bold text-dark mb-1" style="font-weight: 800; font-family: 'Plus Jakarta Sans', sans-serif;">Bảo mật & Tuân thủ</h3>
                    <p class="text-secondary mb-0">Kiểm tra và đánh giá các cấu hình bảo mật, phân quyền đặc quyền tối thiểu (Least Privilege) của hệ thống di trú cloud trên LocalStack.</p>
                </div>
                <div class="d-flex gap-2">
                    <a href="/Security" class="btn btn-outline-secondary" style="border-radius: 8px; font-weight: 600;">
                        <i class="bi bi-arrow-clockwise me-2"></i> Quét lại bảo mật
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- DB Connection Error Alert -->
    @if (!Model.IsLocalStackAvailable && !string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="row mb-4">
            <div class="col-12">
                <div class="alert alert-danger border-danger border-opacity-25 rounded-4 p-4 shadow-sm mb-0">
                    <div class="d-flex gap-3">
                        <i class="bi bi-exclamation-triangle-fill text-danger fs-3 flex-shrink-0"></i>
                        <div>
                            <h5 class="alert-heading text-danger font-bold mb-1" style="font-weight: 700;">Không kết nối được LocalStack</h5>
                            <p class="mb-2">Hệ thống không thể thực hiện kiểm định bảo mật trực tiếp trên LocalStack S3/DynamoDB/Lambda. Dưới đây là thông báo lỗi:</p>
                            <hr class="my-2 border-danger border-opacity-25">
                            <code class="text-xs text-danger font-semibold font-monospace">@Model.ErrorMessage</code>
                            <div class="mt-3">
                                <strong>Cách khắc phục:</strong> Chạy LocalStack và khởi tạo hạ tầng Terraform trước khi chạy quét bảo mật.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Score Card & Category Highlights -->
    <div class="row g-4 mb-4">
        <!-- Circular/Progress Score Card -->
        <div class="col-12 col-xl-4">
            <div class="dashboard-card h-100 d-flex flex-column justify-content-between p-4 align-items-center text-center">
                <div class="w-100 text-start border-bottom pb-2 mb-3">
                    <h5 class="card-title-custom text-dark text-sm" style="font-weight: 700;">
                        <i class="bi bi-shield-check text-success me-2"></i> Điểm tuân thủ bảo mật
                    </h5>
                </div>

                @{
                    string complianceColorClass = Model.StatusBadgeClass.Contains("success") ? "success" : (Model.StatusBadgeClass.Contains("danger") ? "danger" : (Model.StatusBadgeClass.Contains("warning") ? "warning" : "info"));
                }
                <div class="position-relative my-3 d-flex align-items-center justify-content-center" style="width: 150px; height: 150px;">
                    <!-- Circular Score representation using radial gradient/SVG or CSS -->
                    <svg viewBox="0 0 36 36" class="w-100 h-100">
                        <path class="text-light" stroke-width="3" stroke="rgba(226, 232, 240, 0.8)" fill="none" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                        <path class="text-@complianceColorClass" stroke-width="3.2" stroke-dasharray="@Model.ComplianceScore, 100" stroke-linecap="round" stroke="currentColor" fill="none" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                    </svg>
                    <div class="position-absolute text-center">
                        <span class="fs-1 font-bold text-dark font-monospace d-block leading-none">@Model.ComplianceScore</span>
                        <span class="text-xxs text-uppercase text-muted tracking-wider" style="font-size: 9px; font-weight: 700;">Tỉ lệ đạt %</span>
                    </div>
                </div>

                <div class="w-100 mt-2">
                    <span class="status-badge @complianceColorClass px-3 py-2" style="font-size: 13px !important; display: inline-flex; border-radius: 20px;">
                        Trạng thái: @Model.StatusBadge
                    </span>
                    <p class="text-xxs text-muted mt-3 mb-0">Tính toán tự động dựa trên 23 tiêu chí cấu hình bảo mật AWS và IaC.</p>
                </div>
            </div>
        </div>

        <!-- Summary Statistics per Security Group -->
        <div class="col-12 col-xl-8">
            <div class="row g-3 h-100">
                <!-- S3 Security Card -->
                <div class="col-12 col-sm-6">
                    <div class="dashboard-card h-100 p-3 d-flex flex-column justify-content-between">
                        <div class="d-flex align-items-center justify-content-between">
                            <span class="text-xs text-muted font-bold text-uppercase">S3 Security</span>
                            <i class="bi bi-bucket text-primary fs-4"></i>
                        </div>
                        <div class="my-3">
                            @{
                                var s3Passed = Model.CheckItems.Count(c => c.Group == "S3 Security" && c.Status == "PASSED");
                                var s3Total = Model.CheckItems.Count(c => c.Group == "S3 Security");
                                int s3Pct = s3Total > 0 ? (s3Passed * 100) / s3Total : 0;
                            }
                            <h3 class="font-bold text-dark mb-1">@s3Passed / @s3Total</h3>
                            <div class="progress progress-xs w-100 bg-light mt-2" style="height: 6px; border-radius: 3px;">
                                <div class="progress-bar bg-primary" style="width: @s3Pct%; border-radius: 3px;"></div>
                            </div>
                        </div>
                        <span class="text-xxs text-muted">Kiểm tra: Encryption, Versioning, Access Block, Bucket Policy.</span>
                    </div>
                </div>

                <!-- IAM Privilege Card -->
                <div class="col-12 col-sm-6">
                    <div class="dashboard-card h-100 p-3 d-flex flex-column justify-content-between">
                        <div class="d-flex align-items-center justify-content-between">
                            <span class="text-xs text-muted font-bold text-uppercase">IAM Least Privilege</span>
                            <i class="bi bi-shield-lock text-success fs-4"></i>
                        </div>
                        <div class="my-3">
                            @{
                                var iamPassed = Model.CheckItems.Count(c => c.Group == "IAM Security" && c.Status == "PASSED");
                                var iamTotal = Model.CheckItems.Count(c => c.Group == "IAM Security");
                                int iamPct = iamTotal > 0 ? (iamPassed * 100) / iamTotal : 0;
                            }
                            <h3 class="font-bold text-dark mb-1">@iamPassed / @iamTotal</h3>
                            <div class="progress progress-xs w-100 bg-light mt-2" style="height: 6px; border-radius: 3px;">
                                <div class="progress-bar bg-success" style="width: @iamPct%; border-radius: 3px;"></div>
                            </div>
                        </div>
                        <span class="text-xxs text-muted">Kiểm tra: Lambda/App Role, Policy phân tách quyền đọc/ghi.</span>
                    </div>
                </div>

                <!-- DynamoDB Audit Card -->
                <div class="col-12 col-sm-6">
                    <div class="dashboard-card h-100 p-3 d-flex flex-column justify-content-between">
                        <div class="d-flex align-items-center justify-content-between">
                            <span class="text-xs text-muted font-bold text-uppercase">DynamoDB Audit Logs</span>
                            <i class="bi bi-file-earmark-spreadsheet text-info fs-4"></i>
                        </div>
                        <div class="my-3">
                            @{
                                var dbPassed = Model.CheckItems.Count(c => c.Group == "DynamoDB Audit Logs" && c.Status == "PASSED");
                                var dbTotal = Model.CheckItems.Count(c => c.Group == "DynamoDB Audit Logs");
                                int dbPct = dbTotal > 0 ? (dbPassed * 100) / dbTotal : 0;
                            }
                            <h3 class="font-bold text-dark mb-1">@dbPassed / @dbTotal</h3>
                            <div class="progress progress-xs w-100 bg-light mt-2" style="height: 6px; border-radius: 3px;">
                                <div class="progress-bar bg-info" style="width: @dbPct%; border-radius: 3px;"></div>
                            </div>
                        </div>
                        <span class="text-xxs text-muted">Kiểm tra: KeySchema, Billing Mode, Mục đích lưu trữ logs.</span>
                    </div>
                </div>

                <!-- Terraform IaC Card -->
                <div class="col-12 col-sm-6">
                    <div class="dashboard-card h-100 p-3 d-flex flex-column justify-content-between">
                        <div class="d-flex align-items-center justify-content-between">
                            <span class="text-xs text-muted font-bold text-uppercase">Terraform IaC</span>
                            <i class="bi bi-hdd-network text-warning fs-4"></i>
                        </div>
                        <div class="my-3">
                            @{
                                var tfPassed = Model.CheckItems.Count(c => c.Group == "Terraform IaC" && c.Status == "PASSED");
                                var tfTotal = Model.CheckItems.Count(c => c.Group == "Terraform IaC");
                                int tfPct = tfTotal > 0 ? (tfPassed * 100) / tfTotal : 0;
                            }
                            <h3 class="font-bold text-dark mb-1">@tfPassed / @tfTotal</h3>
                            <div class="progress progress-xs w-100 bg-light mt-2" style="height: 6px; border-radius: 3px;">
                                <div class="progress-bar bg-warning" style="width: @tfPct%; border-radius: 3px;"></div>
                            </div>
                        </div>
                        <span class="text-xxs text-muted">Kiểm tra: provider.tf, s3.tf, iam.tf, lambda.tf, dynamodb.tf.</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Detailed Security Checklist Table -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="dashboard-card">
                <div class="card-header-custom border-bottom pb-2 mb-3">
                    <h5 class="card-title-custom text-dark text-sm">
                        <i class="bi bi-patch-check-fill text-primary me-2"></i> Bảng kiểm định tuân thủ chi tiết (Checklist)
                    </h5>
                    <span class="badge bg-primary bg-opacity-10 text-primary">Checklist</span>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 text-sm">
                        <thead class="table-light text-xs text-muted font-bold text-uppercase border-bottom">
                            <tr>
                                <th style="width: 150px;">Nhóm bảo mật</th>
                                <th style="width: 250px;">Hạng mục kiểm tra</th>
                                <th style="width: 120px; text-align: center;">Trạng thái</th>
                                <th style="width: 120px; text-align: center;">Mức độ</th>
                                <th>Chi tiết / Ghi chú kiểm định</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.CheckItems.Any())
                            {
                                foreach (var check in Model.CheckItems)
                                {
                                    <tr>
                                        <td>
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary font-bold text-uppercase" style="font-size: 9px; padding: 4px 8px;">@check.Group</span>
                                        </td>
                                        <td class="font-semibold text-dark">@check.CheckName</td>
                                        <td style="text-align: center;">
                                            @if (check.Status == "PASSED")
                                            {
                                                <span class="badge bg-success bg-opacity-15 text-success font-bold" style="font-size: 10px; width: 80px; display: inline-block; padding: 4px 0;">Đạt</span>
                                            }
                                            else if (check.Status == "WARNING")
                                            {
                                                <span class="badge bg-warning bg-opacity-15 text-warning font-bold" style="font-size: 10px; width: 80px; display: inline-block; padding: 4px 0;">Cảnh báo</span>
                                            }
                                            else if (check.Status == "FAILED")
                                            {
                                                <span class="badge bg-danger bg-opacity-15 text-danger font-bold" style="font-size: 10px; width: 80px; display: inline-block; padding: 4px 0;">Lỗi</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary bg-opacity-15 text-secondary font-bold" style="font-size: 10px; width: 80px; display: inline-block; padding: 4px 0;">Chưa kiểm</span>
                                            }
                                        </td>
                                        <td style="text-align: center;">
                                            @{
                                                string sevColor = "secondary";
                                                if (check.Severity == "CRITICAL") sevColor = "danger";
                                                else if (check.Severity == "HIGH") sevColor = "warning text-dark";
                                                else if (check.Severity == "MEDIUM") sevColor = "info";
                                                else if (check.Severity == "LOW") sevColor = "success";
                                            }
                                            <span class="badge bg-@sevColor font-monospace text-xxs px-2" style="font-size: 9px; font-weight: 700;">@check.Severity</span>
                                        </td>
                                        <td class="text-secondary" style="font-size: 12.5px;">@check.Description</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">Chưa thực hiện quét bảo mật.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- IAM Policy Summary Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="dashboard-card">
                <div class="card-header-custom border-bottom pb-2 mb-3">
                    <h5 class="card-title-custom text-dark text-sm">
                        <i class="bi bi-shield-shaded text-success me-2"></i> Tóm lược các chính sách phân quyền IAM (IAM Policy Summary)
                    </h5>
                    <span class="badge bg-success bg-opacity-10 text-success">Ủy quyền Least Privilege</span>
                </div>
                
                <p class="text-xs text-muted mb-3">
                    <i class="bi bi-info-circle me-1"></i> 
                    <em>Lưu ý: Vì LocalStack Community không hỗ trợ đầy đủ API IAM/IAM Policy, thông tin phân quyền chi tiết dưới đây được phản ánh trực tiếp từ tệp cấu hình hạ tầng `terraform/iam.tf` của dự án.</em>
                </p>

                <div class="row g-3">
                    @foreach (var policy in Model.IamPolicySummaries)
                    {
                        <div class="col-12 col-md-6">
                            <div class="p-3 bg-light rounded-3 border h-100 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap gap-2">
                                        <h6 class="font-bold text-dark mb-0 font-monospace" style="font-size: 13px;">@policy.RoleName</h6>
                                        <span class="badge bg-success bg-opacity-15 text-success text-xxs font-semibold">@policy.Status</span>
                                    </div>
                                    <div class="text-xxs text-muted mb-2 font-semibold">
                                        Ủy thác cho (Principal): <span class="text-dark font-monospace">@policy.Principal</span>
                                    </div>
                                    <div class="text-xxs text-muted mb-2">
                                        Policy liên kết: <code class="text-primary font-monospace">@policy.PolicyName</code>
                                    </div>
                                    
                                    <div class="mt-2">
                                        <span class="text-xxs text-muted font-bold d-block mb-1">Các hành động được phép (Allowed Actions):</span>
                                        <div class="d-flex flex-wrap gap-1">
                                            @foreach (var action in policy.AllowedActions)
                                            {
                                                <span class="badge bg-white border text-dark font-monospace" style="font-size: 9px; padding: 2px 5px;">@action</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="mt-3 pt-2 border-top">
                                    <span class="text-xxs text-muted font-bold d-block">Tài nguyên áp dụng (Resource):</span>
                                    <code class="text-dark font-monospace text-truncate d-block" style="font-size: 10px;" title="@policy.Resource">@policy.Resource</code>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Security Recommendations Section -->
    <div class="row">
        <div class="col-12">
            <div class="dashboard-card border border-warning border-opacity-15 bg-warning bg-opacity-5 rounded-4 p-4">
                <h5 class="text-dark font-bold mb-3" style="font-weight: 700; font-family: 'Plus Jakarta Sans', sans-serif;">
                    <i class="bi bi-shield-fill-exclamation text-warning me-2"></i> Khuyến nghị bảo mật cho môi trường AWS Cloud sản xuất (Production)
                </h5>
                <p class="text-xs text-muted mb-4">Môi trường LocalStack giả lập không áp đặt đầy đủ các biện pháp kiểm soát của AWS, tuy nhiên khi di trú lên AWS Cloud thật, nhóm đồ án bắt buộc phải tuân thủ các quy tắc sau:</p>
                
                <div class="row g-3">
                    <div class="col-12 col-md-4">
                        <div class="d-flex gap-3">
                            <i class="bi bi-eye-slash-fill text-primary fs-4 flex-shrink-0"></i>
                            <div>
                                <h6 class="font-bold text-dark mb-1" style="font-size: 13px;">Không công khai S3 Bucket chứa mã nguồn</h6>
                                <p class="text-xxs text-muted mb-0">Luôn bật tính năng chặn truy cập công khai (Block Public Access) và chỉ cho phép truy cập qua S3 Bucket Policy có VPC Endpoint hoặc IAM Role ủy thác.</p>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-4">
                        <div class="d-flex gap-3">
                            <i class="bi bi-key-fill text-success fs-4 flex-shrink-0"></i>
                            <div>
                                <h6 class="font-bold text-dark mb-1" style="font-size: 13px;">Sử dụng IAM Role & IAM Profile thay vì Access Keys</h6>
                                <p class="text-xxs text-muted mb-0">Tuyệt đối không lưu trữ hay hard-code AWS Access Key ID và Secret Access Key trong tệp tin `appsettings.json`. Sử dụng IAM Instance Profile của EC2 hoặc ECS Task Role để cấp quyền động.</p>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-4">
                        <div class="d-flex gap-3">
                            <i class="bi bi-shield-check text-info fs-4 flex-shrink-0"></i>
                            <div>
                                <h6 class="font-bold text-dark mb-1" style="font-size: 13px;">Áp dụng đặc quyền tối thiểu (Least Privilege)</h6>
                                <p class="text-xxs text-muted mb-0">Thu hẹp phạm vi chính sách IAM Policy. Không sử dụng quyền "*" (wildcard) bừa bãi. Chỉ cấp các quyền tối thiểu cần thiết để vận hành ứng dụng di trú.</p>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-4">
                        <div class="d-flex gap-3">
                            <i class="bi bi-arrow-counterclockwise text-teal fs-4 flex-shrink-0" style="color: #0d9488;"></i>
                            <div>
                                <h6 class="font-bold text-dark mb-1" style="font-size: 13px;">Kích hoạt Versioning & Object Lock trên S3</h6>
                                <p class="text-xxs text-muted mb-0">Versioning cho phép lưu trữ nhiều phiên bản tệp tin backup của SQL Server. Kích hoạt Object Lock để ngăn chặn tấn công mã độc ransomware thay đổi tệp backup.</p>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-4">
                        <div class="d-flex gap-3">
                            <i class="bi bi-clipboard2-data text-indigo fs-4 flex-shrink-0"></i>
                            <div>
                                <h6 class="font-bold text-dark mb-1" style="font-size: 13px;">Ghi vết kiểm toán (Audit Logs) toàn diện</h6>
                                <p class="text-xxs text-muted mb-0">Sử dụng DynamoDB kết hợp với AWS CloudTrail để ghi lại toàn bộ hoạt động của ứng dụng, đảm bảo tính minh bạch và phục vụ công tác điều tra sự cố bảo mật.</p>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-4">
                        <div class="d-flex gap-3">
                            <i class="bi bi-diagram-3-fill text-warning fs-4 flex-shrink-0"></i>
                            <div>
                                <h6 class="font-bold text-dark mb-1" style="font-size: 13px;">Sử dụng Terraform (IaC) để kiểm soát hạ tầng</h6>
                                <p class="text-xxs text-muted mb-0">Định nghĩa toàn bộ hạ tầng bằng code (Infrastructure as Code) giúp chuẩn hóa cấu hình bảo mật, dễ dàng rà soát lỗi qua các công cụ quét bảo mật tĩnh trước khi deploy.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
