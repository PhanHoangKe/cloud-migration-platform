<!-- Section: Before/After Comparison -->
<section id="comparison" class="mb-4">
    <div class="row">
        <div class="col-12">
            <div class="dashboard-card">
                <div class="card-header-custom border-bottom pb-2">
                    <h5 class="card-title-custom text-indigo">
                        <i class="bi bi-arrow-left-right text-indigo me-2"></i> So sánh trước và sau chuyển đổi
                    </h5>
                    <span class="badge bg-indigo bg-opacity-10 text-indigo">On-Premise vs. Cloud</span>
                </div>
                
                <div class="table-responsive mt-3">
                    <table class="table align-middle mb-0" style="border-collapse: separate; border-spacing: 0 10px;">
                        <thead>
                            <tr class="text-uppercase text-xs text-muted tracking-wider border-bottom">
                                <th class="pb-3" style="width: 20%;">Tiêu chí</th>
                                <th class="pb-3" style="width: 40%;">Môi trường On-Premise</th>
                                <th class="pb-3" style="width: 40%;">Môi trường Cloud mô phỏng</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.ComparisonItems)
                            {
                                <tr class="border-bottom-0">
                                    <td class="ps-2">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="bg-indigo bg-opacity-10 text-indigo rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; min-width: 32px;">
                                                <i class="bi @item.Icon"></i>
                                            </div>
                                            <span class="font-bold text-dark text-sm">@item.Category</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="p-3 rounded-3 text-sm text-secondary bg-light border border-secondary border-opacity-10">
                                            <span class="badge bg-danger bg-opacity-10 text-danger mb-2">On-Premise</span>
                                            <p class="mb-0">@item.OnPremiseDetails</p>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="p-3 rounded-3 text-sm text-dark bg-light border border-indigo border-opacity-15 font-semibold">
                                            <span class="badge bg-success bg-opacity-10 text-success mb-2">AWS Cloud</span>
                                            <p class="mb-0">@item.CloudDetails</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // 1. Initialize Cost Chart
            const ctx = document.getElementById('costChart').getContext('2d');
            
            // Dynamic monthly simulated costs calculated on viewmodel counts
            const s3Cost = @(Model.BackupFilesCount > 0 ? 0.08 : 0.0);
            const dbCost = @(Model.MigrationLogsCount > 0 ? 0.10 : 0.0);
            const lambdaCost = @(Model.LatestSelfTestStatus == "Passed" ? 0.05 : 0.0);
            const otherCost = @(Model.EstimatedMonthlyCost > 0 ? 0.07 : 0.0);
 
            const costData = {
                labels: ['Lưu trữ S3', 'DynamoDB', 'Hàm Lambda', 'Khác'],
                datasets: [{
                    data: [s3Cost, dbCost, lambdaCost, otherCost],
                    backgroundColor: [
                        '#6366f1', // Indigo S3
                        '#10b981', // Emerald DynamoDB
                        '#ef4444', // Red Lambda
                        '#94a3b8'  // Gray Other
                    ],
                    borderWidth: 2,
                    borderColor: '#ffffff',
                    hoverOffset: 10
                }]
            };

            const costChart = new Chart(ctx, {
                type: 'doughnut',
                data: costData,
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                font: {
                                    family: 'Plus Jakarta Sans',
                                    size: 12
                                },
                                padding: 15
                            }
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return ` ${context.label}: $${context.raw.toFixed(2)} USD/tháng`;
                                }
                            }
                        }
                    },
                    cutout: '65%'
                }
            });

            // 2. Migration Form Submit Handler
            const btnStart = document.getElementById("btnStartMigration");
            const progressBar = document.getElementById("migrationProgressBar");
            const progressContainer = document.getElementById("migrationProgressContainer");
            const consoleBox = document.getElementById("migrationConsole");
            
            // Console logger function
            function logToConsole(text, type = 'info') {
                const line = document.createElement("div");
                line.className = "console-line";
                
                let prefix = "";
                let classType = "text-white";
                
                if (type === 'info') {
                    prefix = "[INFO] ";
                    classType = "c-info";
                } else if (type === 'tf') {
                    prefix = "[TERRAFORM] ";
                    classType = "c-tf";
                } else if (type === 'success') {
                    prefix = "[SUCCESS] ";
                    classType = "c-success";
                }
                
                line.innerHTML = `<span class="${classType}">${prefix}${text}</span>`;
                consoleBox.appendChild(line);
                consoleBox.scrollTop = consoleBox.scrollHeight;
            }

            const migrationForm = document.getElementById("migrationForm");
            if (migrationForm) {
                migrationForm.addEventListener("submit", function (e) {
                    btnStart.disabled = true;
                    btnStart.innerHTML = `<i class="bi bi-arrow-repeat spin d-inline-block text-white"></i> Đang chuyển đổi...`;
                    btnStart.classList.remove("btn-primary");
                    btnStart.classList.add("btn-warning");
                    
                    progressContainer.classList.remove("d-none");
                    progressBar.style.width = "45%";
                    
                    consoleBox.innerHTML = "";
                    logToConsole("Đang khởi tạo kết nối đến LocalStack endpoints...", "info");
                    logToConsole("Đang cấu hình thông tin xác thực giả lập...", "info");
                    logToConsole("Đang thiết lập tài nguyên đám mây (S3/DynamoDB)...", "tf");
                    logToConsole("Đang kết xuất và tải lên bản sao lưu cơ sở dữ liệu...", "info");
                });
            }

            const rollbackForm = document.getElementById("rollbackForm");
            const btnRollback = document.getElementById("btnRollbackMigration");
            if (rollbackForm && btnRollback) {
                rollbackForm.addEventListener("submit", function (e) {
                    btnRollback.disabled = true;
                    btnRollback.innerHTML = `<i class="bi bi-arrow-repeat spin d-inline-block"></i> Đang khôi phục...`;
                    btnRollback.classList.remove("btn-outline-danger");
                    btnRollback.classList.add("btn-danger");
                });
            }
        });
    </script>
}
