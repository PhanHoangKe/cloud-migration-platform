@model MigrationDashboard.Models.CloudResourceDashboardViewModel
@{
    ViewData["Title"] = "Cloud Migration Dashboard";
}

<!-- Section: LocalStack Warning Banner -->
@if (!Model.IsLocalStackAvailable)
{
    <div class="row mb-4">
        <div class="col-12">
            <div class="alert alert-warning border-warning border-opacity-25 rounded-3 d-flex align-items-center justify-content-between p-3 mb-0 shadow-sm" role="alert">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-exclamation-triangle-fill text-warning fs-5"></i>
                    <div>
                        <strong>Cảnh báo: LocalStack unavailable!</strong> Cổng kết nối LocalStack <code class="text-dark">http://localhost:4566</code> đang ngoại tuyến. Hệ thống hiển thị trạng thái giả lập (Offline) để demo ổn định.
                    </div>
                </div>
                <span class="badge bg-warning text-dark">Simulated Mode</span>
            </div>
        </div>
    </div>
}

<!-- Section: Hero & Health Score -->
<section id="dashboard" class="mb-4">
    <div class="row g-4">
        <!-- Hero Card -->
        <div class="col-lg-9 col-md-8">
            <div class="hero-card h-100 d-flex flex-column justify-content-between">
                <div class="hero-content">
                    <span class="badge bg-primary bg-opacity-25 text-primary-light mb-3 px-3 py-2 rounded-pill border border-primary border-opacity-50">
                        <i class="bi bi-award-fill me-1"></i> Đồ án Điện toán đám mây
                    </span>
                    <h2 class="hero-title">Cloud Migration & Modernization Platform</h2>
                    <p class="hero-desc">
                        Hệ thống mô phỏng quy trình chuyển đổi ứng dụng ASP.NET Core 9 + SQL Server từ môi trường truyền thống (On-premise) lên hạ tầng điện toán đám mây (AWS Cloud) sử dụng LocalStack và công cụ Terraform để cấu hình hạ tầng dạng Code (Infrastructure as Code - IaC).
                    </p>
                </div>
                <div class="tech-badge-container">
                    <span class="tech-badge"><i class="bi bi-braces me-1"></i> ASP.NET Core 9</span>
                    <span class="tech-badge"><i class="bi bi-database me-1"></i> SQL Server</span>
                    <span class="tech-badge"><i class="bi bi-cloud-check-fill me-1 text-success"></i> LocalStack (AWS)</span>
                    <span class="tech-badge"><i class="bi bi-boxes me-1 text-warning"></i> Terraform IaC</span>
                </div>
            </div>
        </div>
        <!-- Health Score Card -->
        <div class="col-lg-3 col-md-4">
            <div class="dashboard-card text-center d-flex flex-column align-items-center justify-content-center">
                <h6 class="text-uppercase tracking-wider text-muted font-semibold mb-3">Migration Health</h6>
                <div class="health-score-container">
                    @{
                        string healthColor = Model.MigrationHealthScore >= 75 ? "#10b981" : (Model.MigrationHealthScore >= 50 ? "#3b82f6" : "#ef4444");
                        double healthDegrees = Model.MigrationHealthScore * 3.6;
                        string healthLabel = Model.MigrationHealthScore >= 90 ? "Cloud-Native" : (Model.MigrationHealthScore >= 50 ? "Hybrid" : "On-Premise");
                    }
                    <div class="health-circle-outer" id="healthScoreCircle" style="background: conic-gradient(@healthColor 0deg, @healthColor @(healthDegrees)deg, #334155 @(healthDegrees)deg);">
                        <div class="health-circle-inner">
                            <span class="health-value" id="healthScoreValue">@Model.MigrationHealthScore</span>
                            <span class="health-label" id="healthScoreLabel">@healthLabel</span>
                        </div>
                    </div>
                </div>
                <div class="mt-3 text-muted small" id="healthScoreSub">
                    @if (!Model.IsLocalStackAvailable)
                    {
                        <span>LocalStack offline. Trạng thái giả lập.</span>
                    }
                    else
                    {
                        <span>Hạ tầng di trú hoàn tất @Model.MigrationHealthScore%.</span>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Section: Statistics Cards -->
<section id="stats" class="mb-4">
    <div class="row g-4">
        <!-- Card 1: S3 Bucket -->
        <div class="col-xl-3 col-md-6">
            <div class="dashboard-card" id="statCardS3">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    @{
                        string s3IconClass = string.IsNullOrEmpty(Model.S3ErrorMessage) ? "success" : "danger";
                        string s3BadgeClass = string.IsNullOrEmpty(Model.S3ErrorMessage) ? "success" : "danger";
                        string s3BadgeText = string.IsNullOrEmpty(Model.S3ErrorMessage) ? "Active" : "Error";
                        string s3ValueText = Model.BackupFilesCount > 0 ? $"{Model.BackupFilesCount} Files" : "0 Files";
                    }
                    <div class="stat-icon @s3IconClass" id="statIconS3">
                        <i class="bi bi-folder-symlink"></i>
                    </div>
                    <span class="badge bg-@s3BadgeClass bg-opacity-10 text-@s3BadgeClass" id="badgeS3">@s3BadgeText</span>
                </div>
                <h6 class="stat-label">S3 Backup Bucket</h6>
                <h4 class="stat-value" id="valS3">@s3ValueText</h4>
            </div>
        </div>
        <!-- Card 2: DynamoDB Logs -->
        <div class="col-xl-3 col-md-6">
            <div class="dashboard-card" id="statCardDynamo">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    @{
                        string dbIconClass = string.IsNullOrEmpty(Model.DynamoDbErrorMessage) ? "success" : "danger";
                        string dbBadgeClass = string.IsNullOrEmpty(Model.DynamoDbErrorMessage) ? "success" : "danger";
                        string dbBadgeText = string.IsNullOrEmpty(Model.DynamoDbErrorMessage) ? "Ready" : "Error";
                        string dbValueText = Model.MigrationLogsCount > 0 ? $"{Model.MigrationLogsCount} Logs" : "0 Logs";
                    }
                    <div class="stat-icon @dbIconClass" id="statIconDynamo">
                        <i class="bi bi-journal-text"></i>
                    </div>
                    <span class="badge bg-@dbBadgeClass bg-opacity-10 text-@dbBadgeClass" id="badgeDynamo">@dbBadgeText</span>
                </div>
                <h6 class="stat-label">DynamoDB Logs</h6>
                <h4 class="stat-value" id="valDynamo">@dbValueText</h4>
            </div>
        </div>
        <!-- Card 3: Lambda Function -->
        <div class="col-xl-3 col-md-6">
            <div class="dashboard-card" id="statCardLambda">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    @{
                        string lambdaIconClass = Model.LatestSelfTestStatus == "Passed" ? "success" : (Model.LatestSelfTestStatus == "Failed" ? "danger" : "secondary");
                        string lambdaBadgeClass = Model.LatestSelfTestStatus == "Passed" ? "success" : (Model.LatestSelfTestStatus == "Failed" ? "danger" : "secondary");
                        string lambdaBadgeText = Model.LatestSelfTestStatus;
                    }
                    <div class="stat-icon @lambdaIconClass" id="statIconLambda">
                        <i class="bi bi-lightning-charge"></i>
                    </div>
                    <span class="badge bg-@lambdaBadgeClass bg-opacity-10 text-@lambdaBadgeClass" id="badgeLambda">@lambdaBadgeText</span>
                </div>
                <h6 class="stat-label">Lambda Self-test</h6>
                <h4 class="stat-value" id="valLambda">@Model.LatestSelfTestStatus</h4>
            </div>
        </div>
        <!-- Card 4: Estimated Cost -->
        <div class="col-xl-3 col-md-6">
            <div class="dashboard-card" id="statCardCost">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="stat-icon success" id="statIconCost">
                        <i class="bi bi-cash-stack"></i>
                    </div>
                    <span class="badge bg-success bg-opacity-10 text-success">Active</span>
                </div>
                <h6 class="stat-label">Estimated Cost</h6>
                <h4 class="stat-value" id="valCost">$@Model.EstimatedMonthlyCost.ToString("F2")/month</h4>
            </div>
        </div>
    </div>
</section>

<!-- Section: Migration Center & Cloud Resources -->
<div class="row g-4 mb-4">
    <!-- Migration Center -->
    <div class="col-lg-7" id="migration-center">
        <div class="dashboard-card d-flex flex-column justify-content-between h-100">
            <div>
                <div class="card-header-custom">
                    <h5 class="card-title-custom">
                        <i class="bi bi-play-circle text-primary"></i> Migration Center
                    </h5>
                    <form asp-controller="Migration" asp-action="Start" method="post" id="migrationForm">
                        <button type="submit" class="btn btn-primary btn-start-migration" id="btnStartMigration">
                            <i class="bi bi-rocket-takeoff me-2"></i> Start Migration
                        </button>
                    </form>
                </div>
                
                <!-- Progress Bar -->
                <div class="progress mb-4 d-none" id="migrationProgressContainer" style="height: 8px; border-radius: 4px;">
                    <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary" role="progressbar" style="width: 0%" id="migrationProgressBar"></div>
                </div>

                <!-- Timeline -->
                <div class="timeline" id="migrationTimeline">
                    <div class="timeline-item @(Model.BackupFilesCount > 0 ? "success" : "")" id="timeStep1">
                        <div class="timeline-badge">
                            @if (Model.BackupFilesCount > 0) { <i class="bi bi-check-lg"></i> } else { <i class="bi bi-1-circle-fill"></i> }
                        </div>
                        <div class="timeline-content">
                            <h6 class="timeline-title">Export dữ liệu từ On-premise</h6>
                            <p class="timeline-desc">Kết xuất Database SQL Server thành file backup .bak và đóng gói dữ liệu.</p>
                        </div>
                    </div>
                    <div class="timeline-item @(Model.BackupFilesCount > 0 ? "success" : "")" id="timeStep2">
                        <div class="timeline-badge">
                            @if (Model.BackupFilesCount > 0) { <i class="bi bi-check-lg"></i> } else { <i class="bi bi-2-circle-fill"></i> }
                        </div>
                        <div class="timeline-content">
                            <h6 class="timeline-title">Upload backup lên S3</h6>
                            <p class="timeline-desc">Chuyển tệp dữ liệu lưu trữ vào Amazon S3 Bucket được mô phỏng bởi LocalStack.</p>
                        </div>
                    </div>
                    <div class="timeline-item @(Model.MigrationLogsCount > 2 ? "success" : "")" id="timeStep3">
                        <div class="timeline-badge">
                            @if (Model.MigrationLogsCount > 2) { <i class="bi bi-check-lg"></i> } else { <i class="bi bi-3-circle-fill"></i> }
                        </div>
                        <div class="timeline-content">
                            <h6 class="timeline-title">Ghi migration logs vào DynamoDB</h6>
                            <p class="timeline-desc">Tạo lịch sử chuyển đổi và lưu trạng thái chuyển đổi ứng dụng vào DynamoDB table.</p>
                        </div>
                    </div>
                    <div class="timeline-item @(Model.LatestSelfTestStatus == "Passed" ? "success" : "")" id="timeStep4">
                        <div class="timeline-badge">
                            @if (Model.LatestSelfTestStatus == "Passed") { <i class="bi bi-check-lg"></i> } else { <i class="bi bi-4-circle-fill"></i> }
                        </div>
                        <div class="timeline-content">
                            <h6 class="timeline-title">Chạy Lambda Post-migration Self-test</h6>
                            <p class="timeline-desc">Kích hoạt Lambda function kiểm tra tính toàn vẹn và kết nối dữ liệu sau migration.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Terminal Mock Console -->
            <div class="mt-4">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-xs text-muted font-bold text-uppercase"><i class="bi bi-terminal me-1"></i> Deployment Logs</span>
                    <span class="badge bg-dark text-white border border-secondary border-opacity-25 px-2 py-1">Terraform & LocalStack</span>
                </div>
                <div class="console-box" id="migrationConsole">
                    @if (Model.RecentLogs.Any())
                    {
                        <div class="console-line text-success">[INFO] Connected to LocalStack database logs... displaying recent events:</div>
                        @foreach (var log in Model.RecentLogs.Take(5))
                        {
                            <div class="console-line">
                                <span class="text-muted">[@log.Timestamp]</span>
                                <span class="c-info">[@log.Status]</span>
                                <span class="text-white">@log.Message</span>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="console-line text-muted">Ready to run simulation. Click "Start Migration" above to begin...</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Cloud Resources -->
    <div class="col-lg-5" id="cloud-resources">
        <div class="dashboard-card h-100">
            <div class="card-header-custom">
                <h5 class="card-title-custom">
                    <i class="bi bi-hdd-network text-success"></i> Cloud Resources
                </h5>
                <span class="badge bg-success bg-opacity-10 text-success">LocalStack Endpoint</span>
            </div>
            
            <div class="resource-list mt-3">
                <!-- Resource 1 -->
                <div class="resource-list-item">
                    <div class="resource-info">
                        <div class="resource-icon s3">
                            <i class="bi bi-archive-fill"></i>
                        </div>
                        <div>
                            <div class="resource-name">S3 Bucket</div>
                            <div class="resource-type">Backup Storage</div>
                        </div>
                    </div>
                    <div class="resource-value" data-bs-toggle="tooltip" title="@Model.S3BucketName">@Model.S3BucketName</div>
                </div>
                @if (!string.IsNullOrEmpty(Model.S3ErrorMessage))
                {
                    <div class="text-danger text-xs px-3 mb-2"><i class="bi bi-exclamation-circle-fill me-1"></i> @Model.S3ErrorMessage</div>
                }
                
                <!-- Resource 2 -->
                <div class="resource-list-item">
                    <div class="resource-info">
                        <div class="resource-icon dynamodb">
                            <i class="bi bi-database-fill-gear"></i>
                        </div>
                        <div>
                            <div class="resource-name">DynamoDB Table</div>
                            <div class="resource-type">Log Database</div>
                        </div>
                    </div>
                    <div class="resource-value" data-bs-toggle="tooltip" title="@Model.DynamoDbTableName">@Model.DynamoDbTableName</div>
                </div>
                @if (!string.IsNullOrEmpty(Model.DynamoDbErrorMessage))
                {
                    <div class="text-danger text-xs px-3 mb-2"><i class="bi bi-exclamation-circle-fill me-1"></i> @Model.DynamoDbErrorMessage</div>
                }
                
                <!-- Resource 3 -->
                <div class="resource-list-item">
                    <div class="resource-info">
                        <div class="resource-icon lambda">
                            <i class="bi bi-cpu-fill"></i>
                        </div>
                        <div>
                            <div class="resource-name">Lambda Function</div>
                            <div class="resource-type">Serverless Self-test</div>
                        </div>
                    </div>
                    <div class="resource-value" data-bs-toggle="tooltip" title="@Model.LambdaFunctionName">@Model.LambdaFunctionName</div>
                </div>
                @if (!string.IsNullOrEmpty(Model.LambdaErrorMessage))
                {
                    <div class="text-danger text-xs px-3 mb-2"><i class="bi bi-exclamation-circle-fill me-1"></i> @Model.LambdaErrorMessage</div>
                }
                
                <!-- Resource 4 -->
                <div class="resource-list-item">
                    <div class="resource-info">
                        <div class="resource-icon iam">
                            <i class="bi bi-shield-lock-fill"></i>
                        </div>
                        <div>
                            <div class="resource-name">IAM Roles & Policies</div>
                            <div class="resource-type">Access Management</div>
                        </div>
                    </div>
                    <div class="resource-value" data-bs-toggle="tooltip" title="least privilege model">least privilege</div>
                </div>
            </div>

            <!-- Additional Detail/LocalStack Port Info -->
            <div class="mt-4 p-3 bg-light rounded-3 border border-dashed border-secondary border-opacity-25">
                <h6 class="text-xs text-muted font-bold text-uppercase mb-2"><i class="bi bi-info-circle me-1 text-primary"></i> LocalStack Local Mappings</h6>
                <div class="d-flex justify-content-between text-xs mb-1">
                    <span class="text-muted">Edge Port:</span>
                    <span class="font-monospace text-dark font-semibold">localhost:4566</span>
                </div>
                <div class="d-flex justify-content-between text-xs mb-1">
                    <span class="text-muted">Terraform State:</span>
                    <span class="font-monospace text-success font-semibold">localstack.tfstate</span>
                </div>
                <div class="d-flex justify-content-between text-xs">
                    <span class="text-muted">SQL Database:</span>
                    <span class="font-monospace text-primary font-semibold">On-Prem (Port 1433)</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Section: Live Cloud Resource Backups & Logs Tables -->
<div class="row g-4 mb-4">
    <!-- S3 Backups Table -->
    <div class="col-lg-6">
        <div class="dashboard-card">
            <div class="card-header-custom border-bottom pb-2">
                <h5 class="card-title-custom text-warning">
                    <i class="bi bi-file-earmark-zip-fill"></i> Recent S3 Backups
                </h5>
                <span class="badge bg-warning bg-opacity-10 text-warning">@Model.BackupFilesCount Total</span>
            </div>
            <div class="table-responsive mt-3" style="max-height: 280px; overflow-y: auto;">
                <table class="table table-hover align-middle mb-0 text-sm">
                    <thead class="table-light sticky-top">
                        <tr>
                            <th>Object Key</th>
                            <th>Size</th>
                            <th>Last Modified</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentBackups.Any())
                        {
                            @foreach (var backup in Model.RecentBackups)
                            {
                                <tr>
                                    <td class="font-monospace text-xs text-dark font-semibold">@backup.Key</td>
                                    <td>@((backup.Size / 1024.0).ToString("F1")) KB</td>
                                    <td class="text-muted text-xs">@backup.LastModified.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center text-muted py-4">
                                    <i class="bi bi-folder2-open d-block fs-3 mb-2 text-secondary"></i>
                                    No backup files found in S3 bucket.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- DynamoDB Logs Table -->
    <div class="col-lg-6">
        <div class="dashboard-card">
            <div class="card-header-custom border-bottom pb-2">
                <h5 class="card-title-custom text-primary">
                    <i class="bi bi-database-fill"></i> Recent Migration Logs
                </h5>
                <span class="badge bg-primary bg-opacity-10 text-primary">@Model.MigrationLogsCount Total</span>
            </div>
            <div class="table-responsive mt-3" style="max-height: 280px; overflow-y: auto;">
                <table class="table table-hover align-middle mb-0 text-sm">
                    <thead class="table-light sticky-top">
                        <tr>
                            <th>MigrationId</th>
                            <th>Status</th>
                            <th>Message</th>
                            <th>Timestamp</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentLogs.Any())
                        {
                            @foreach (var log in Model.RecentLogs)
                            {
                                <tr>
                                    <td class="font-monospace text-xs text-primary font-semibold">@log.MigrationId</td>
                                    <td>
                                        @{
                                            string badgeColor = log.Status == "COMPLETED" || log.Status == "SELF_TEST_PASSED" ? "success" :
                                                                (log.Status == "STARTED" || log.Status == "SELF_TEST_TRIGGERED" ? "info" : "danger");
                                        }
                                        <span class="badge bg-@badgeColor bg-opacity-10 text-@badgeColor text-xs">@log.Status</span>
                                    </td>
                                    <td class="text-xs text-dark" style="max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="@log.Message">
                                        @log.Message
                                    </td>
                                    <td class="text-muted text-xs">@log.Timestamp</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">
                                    <i class="bi bi-journal-x d-block fs-3 mb-2 text-secondary"></i>
                                    No migration logs found in DynamoDB.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Section: Cost Estimation & Architecture -->
<div class="row g-4 mb-4">
    <!-- Cost Estimation -->
    <div class="col-lg-5" id="cost-estimation">
        <div class="dashboard-card h-100 d-flex flex-column justify-content-between">
            <div>
                <div class="card-header-custom">
                    <h5 class="card-title-custom">
                        <i class="bi bi-currency-dollar text-warning"></i> Cost Estimation
                    </h5>
                    <span class="badge bg-warning bg-opacity-10 text-warning" id="costTotalBadge">$@Model.EstimatedMonthlyCost.ToString("F2") / Month</span>
                </div>
                
                <div class="chart-container-custom d-flex align-items-center justify-content-center mt-3">
                    <canvas id="costChart"></canvas>
                </div>

                <div class="table-responsive mt-3 text-xs">
                    <table class="table table-sm table-borderless align-middle mb-0">
                        <thead>
                            <tr class="border-bottom text-muted">
                                <th>Dịch vụ</th>
                                <th class="text-end">Chi phí / Tháng</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cost in Model.CostItems)
                            {
                                <tr>
                                    <td>
                                        <div class="font-bold text-dark">@cost.ServiceName</div>
                                        <div class="text-muted text-xxs" style="font-size: 10px;">@cost.Description</div>
                                    </td>
                                    <td class="text-end font-monospace font-semibold text-dark">
                                        $@cost.CostPerMonth.ToString("F2")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            
            <div class="cost-note mt-3">
                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                Chi phí chỉ dùng để minh họa trong môi trường học thuật LocalStack, không phải bảng giá chính thức của AWS.
            </div>
        </div>
    </div>

    <!-- Architecture Overview -->
    <div class="col-lg-7" id="architecture">
        <div class="dashboard-card h-100">
            <div class="card-header-custom">
                <h5 class="card-title-custom">
                    <i class="bi bi-diagram-3 text-info"></i> Architecture Overview
                </h5>
                <span class="badge bg-info bg-opacity-10 text-info">Hybrid Flow</span>
            </div>
            
            <div class="architecture-flow mt-3">
                <!-- User / Lecturer Node -->
                <div class="arch-node">
                    <div class="arch-node-title text-primary">
                        <i class="bi bi-person-workspace"></i> User / Lecturer (Client)
                    </div>
                    <div class="arch-node-desc">Gửi yêu cầu truy cập & kích hoạt di trú dữ liệu</div>
                </div>

                <div class="arch-arrow">
                    <i class="bi bi-arrow-down-short"></i>
                </div>

                <!-- Web Application Dashboard Node -->
                <div class="arch-node">
                    <div class="arch-node-title text-indigo" style="color: #6366f1;">
                        <i class="bi bi-file-code-fill"></i> ASP.NET Core 9 Dashboard
                    </div>
                    <div class="arch-node-desc">Dashboard giao diện và Client kết nối LocalStack API</div>
                </div>

                <div class="arch-arrow">
                    <i class="bi bi-arrow-down-short"></i>
                </div>

                <!-- AWS Cloud Group -->
                <div class="arch-cloud-group">
                    <span class="arch-cloud-tag"><i class="bi bi-cloud-fill me-1"></i> AWS Cloud (LocalStack)</span>
                    <div class="arch-cloud-nodes">
                        <!-- Node Cloud S3 -->
                        <div class="arch-node">
                            <div class="arch-node-title text-warning">
                                <i class="bi bi-archive-fill"></i> Amazon S3
                            </div>
                            <div class="arch-node-desc">Lưu trữ SQL Server Backup (.bak)</div>
                        </div>
                        
                        <!-- Node Cloud DynamoDB -->
                        <div class="arch-node">
                            <div class="arch-node-title text-primary">
                                <i class="bi bi-database-fill-gear"></i> DynamoDB Logs
                            </div>
                            <div class="arch-node-desc">Ghi nhật ký tiến trình chuyển đổi</div>
                        </div>

                        <!-- Node Cloud Lambda -->
                        <div class="arch-node col-span-2 w-100" style="grid-column: span 2;">
                            <div class="arch-node-title text-danger">
                                <i class="bi bi-cpu-fill"></i> Lambda Self-test Function
                            </div>
                            <div class="arch-node-desc">Tự động kiểm tra liên thông hạ tầng sau di trú</div>
                        </div>
                    </div>
                </div>
            </div>
</div>

<!-- Section: Before/After Comparison -->
<section id="comparison" class="mb-4">
    <div class="row">
        <div class="col-12">
            <div class="dashboard-card">
                <div class="card-header-custom border-bottom pb-2">
                    <h5 class="card-title-custom text-indigo">
                        <i class="bi bi-arrow-left-right text-indigo me-2"></i> Before / After Comparison
                    </h5>
                    <span class="badge bg-indigo bg-opacity-10 text-indigo">On-Premise vs. Cloud-Native</span>
                </div>
                
                <div class="table-responsive mt-3">
                    <table class="table align-middle mb-0" style="border-collapse: separate; border-spacing: 0 10px;">
                        <thead>
                            <tr class="text-uppercase text-xs text-muted tracking-wider border-bottom">
                                <th class="pb-3" style="width: 20%;">Tiêu chí</th>
                                <th class="pb-3" style="width: 40%;">Môi trường On-Premise</th>
                                <th class="pb-3" style="width: 40%;">Môi trường Cloud (Simulation)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.ComparisonItems)
                            {
                                <tr class="border-bottom-0">
                                    <td class="ps-2">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="bg-indigo bg-opacity-10 text-indigo rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; min-width: 32px;">
                                                <i class="bi @item.Icon"></i>
                                            </div>
                                            <span class="font-bold text-dark text-sm">@item.Category</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="p-3 rounded-3 text-sm text-secondary bg-danger bg-opacity-5 border border-danger border-opacity-10">
                                            @item.OnPremiseDetails
                                        </div>
                                    </td>
                                    <td>
                                        <div class="p-3 rounded-3 text-sm text-dark bg-success bg-opacity-5 border border-success border-opacity-10 font-semibold">
                                            @item.CloudDetails
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // 1. Initialize Cost Chart
            const ctx = document.getElementById('costChart').getContext('2d');
            
            // Dynamic monthly simulated costs calculated on viewmodel counts
            const s3Cost = @(Model.BackupFilesCount > 0 ? 0.08 : 0.0);
            const dbCost = @(Model.MigrationLogsCount > 0 ? 0.10 : 0.0);
            const lambdaCost = @(Model.LatestSelfTestStatus == "Passed" ? 0.05 : 0.0);
            const otherCost = @(Model.EstimatedMonthlyCost > 0 ? 0.07 : 0.0);

            const costData = {
                labels: ['S3 Storage', 'DynamoDB', 'Lambda', 'Other'],
                datasets: [{
                    data: [s3Cost, dbCost, lambdaCost, otherCost],
                    backgroundColor: [
                        '#6366f1', // Indigo S3
                        '#10b981', // Emerald DynamoDB
                        '#ef4444', // Red Lambda
                        '#94a3b8'  // Gray Other
                    ],
                    borderWidth: 2,
                    borderColor: '#ffffff',
                    hoverOffset: 10
                }]
            };

            const costChart = new Chart(ctx, {
                type: 'doughnut',
                data: costData,
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                font: {
                                    family: 'Plus Jakarta Sans',
                                    size: 12
                                },
                                padding: 15
                            }
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return ` ${context.label}: $${context.raw.toFixed(2)} USD`;
                                }
                            }
                        }
                    },
                    cutout: '65%'
                }
            });

            // 2. Migration Form Submit Handler
            const btnStart = document.getElementById("btnStartMigration");
            const progressBar = document.getElementById("migrationProgressBar");
            const progressContainer = document.getElementById("migrationProgressContainer");
            const consoleBox = document.getElementById("migrationConsole");
            
            // Console logger function
            function logToConsole(text, type = 'info') {
                const line = document.createElement("div");
                line.className = "console-line";
                
                let prefix = "";
                let classType = "text-white";
                
                if (type === 'info') {
                    prefix = "[INFO] ";
                    classType = "c-info";
                } else if (type === 'tf') {
                    prefix = "[TERRAFORM] ";
                    classType = "c-tf";
                } else if (type === 'success') {
                    prefix = "[SUCCESS] ";
                    classType = "c-success";
                }
                
                line.innerHTML = `<span class="${classType}">${prefix}${text}</span>`;
                consoleBox.appendChild(line);
                consoleBox.scrollTop = consoleBox.scrollHeight;
            }

            const migrationForm = document.getElementById("migrationForm");
            if (migrationForm) {
                migrationForm.addEventListener("submit", function (e) {
                    btnStart.disabled = true;
                    btnStart.innerHTML = `<i class="bi bi-arrow-repeat spin d-inline-block"></i> Migrating...`;
                    btnStart.classList.remove("btn-primary");
                    btnStart.classList.add("btn-warning");
                    
                    progressContainer.classList.remove("d-none");
                    progressBar.style.width = "45%";
                    
                    consoleBox.innerHTML = "";
                    logToConsole("Initializing connection to LocalStack endpoints...", "info");
                    logToConsole("Reading credential configurations...", "info");
                    logToConsole("Provisioning cloud backup resources...", "tf");
                    logToConsole("Uploading local application SQL database backups...", "info");
                });
            }
        });
    </script>
}
