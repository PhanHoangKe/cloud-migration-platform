                    <div class="text-uppercase text-xs text-muted font-bold mb-3 text-center" style="font-size: 11px;"><i class="bi bi-cloud-fill text-primary"></i> Hạ tầng LocalStack (Giả lập AWS)</div>
                    <div class="d-flex flex-column gap-2">
                        <!-- 4. S3 Backup -->
                        <div class="arch-sub-node">
                            <i class="bi bi-archive-fill text-warning"></i>
                            <div>
                                <strong class="text-sm">4. S3 Backup</strong>
                                <span class="text-xxs text-muted d-block" style="font-size: 10px;">Lưu trữ tệp sao lưu dữ liệu (.json)</span>
                            </div>
                        </div>
                        <!-- 5. DynamoDB Logs -->
                        <div class="arch-sub-node">
                            <i class="bi bi-database-fill-gear text-primary"></i>
                            <div>
                                <strong class="text-sm">5. DynamoDB Logs</strong>
                                <span class="text-xxs text-muted d-block" style="font-size: 10px;">Nhật ký và dấu vết trạng thái chuyển đổi</span>
                            </div>
                        </div>
                        <!-- 6. Lambda Self-test -->
                        <div class="arch-sub-node">
                            <i class="bi bi-cpu-fill text-danger"></i>
                            <div>
                                <strong class="text-sm">6. Lambda Self-test</strong>
