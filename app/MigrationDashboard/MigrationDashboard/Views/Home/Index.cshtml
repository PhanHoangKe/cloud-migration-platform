                <!-- 7. Terraform IaC + LocalStack -->
                <div class="arch-node-flat">
                    <div class="arch-icon-wrapper text-success"><i class="bi bi-boxes"></i></div>
                    <div class="arch-text-wrapper">
                        <div class="arch-node-title">7. Terraform IaC + LocalStack</div>
                        <div class="arch-node-desc">Quản lý vòng đời và tự động hóa toàn bộ tài nguyên đám mây</div>
