@model MigrationDashboard.Models.CloudResourceDashboardViewModel
@{
    ViewData["Title"] = "Hệ thống chuyển đổi Cloud";
}

<!-- Section: TempData Alerts -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="row mb-4">
        <div class="col-12">
            <div class="alert alert-success border-success border-opacity-25 rounded-3 d-flex align-items-center justify-content-between p-3 mb-0 shadow-sm" role="alert">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-check-circle-fill text-success fs-5"></i>
                    <div>
                        <strong>Thành công!</strong> @TempData["SuccessMessage"]
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="row mb-4">
        <div class="col-12">
            <div class="alert alert-danger border-danger border-opacity-25 rounded-3 d-flex align-items-center justify-content-between p-3 mb-0 shadow-sm" role="alert">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-exclamation-octagon-fill text-danger fs-5"></i>
                    <div>
                        <strong>Thất bại!</strong> @TempData["ErrorMessage"]
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    </div>
}

<!-- Section: LocalStack Warning Banner -->
@if (!Model.IsLocalStackAvailable)
{
    <div class="row mb-4">
        <div class="col-12">
            <div class="alert alert-warning border-warning border-opacity-25 rounded-3 d-flex align-items-center justify-content-between p-3 mb-0 shadow-sm" role="alert">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-exclamation-triangle-fill text-warning fs-5"></i>
                    <div>
                        <strong>Cảnh báo: LocalStack ngoại tuyến!</strong> Cổng kết nối LocalStack <code class="text-dark">http://localhost:4566</code> đang ngoại tuyến. Hệ thống hiển thị trạng thái giả lập (Offline) để đảm bảo chạy demo ổn định.
                    </div>
                </div>
                <span class="badge bg-warning text-dark">Chế độ giả lập</span>
            </div>
        </div>
    </div>
}

<!-- Section: Hero & Health Score -->
<section id="dashboard" class="mb-4">
    <div class="row g-4">
        <!-- Hero Card -->
        <div class="col-lg-6 col-md-12">
            <div class="hero-card h-100 d-flex flex-column justify-content-between">
                <div class="hero-content">
                    <span class="badge bg-primary bg-opacity-25 text-primary-light mb-3 px-3 py-2 rounded-pill border border-primary border-opacity-50">
                        <i class="bi bi-award-fill me-1"></i> Đồ án Điện toán đám mây
                    </span>
                    <h2 class="hero-title">Cloud Migration & Modernization Platform</h2>
                    <p class="hero-desc">
                        Mô phỏng quy trình chuyển đổi ứng dụng ASP.NET Core 9 + SQL Server từ môi trường On-premise lên hạ tầng Cloud giả lập bằng LocalStack và Terraform.
                    </p>
                </div>
                <div class="tech-badge-container">
                    <span class="tech-badge"><i class="bi bi-braces me-1"></i> ASP.NET Core 9</span>
                    <span class="tech-badge"><i class="bi bi-database me-1"></i> SQL Server</span>
                    <span class="tech-badge"><i class="bi bi-cloud-check-fill me-1 text-success"></i> LocalStack</span>
                    <span class="tech-badge"><i class="bi bi-boxes me-1 text-warning"></i> Terraform IaC</span>
                </div>
            </div>
        </div>
        <!-- Assessment Summary Card -->
        <div class="col-lg-3 col-md-6">
            <div class="dashboard-card text-center d-flex flex-column align-items-center justify-content-between h-100">
                <div>
                    <h6 class="text-uppercase tracking-wider text-muted font-semibold mb-2" style="font-size: 12px; letter-spacing: 1px;">ĐÁNH GIÁ NGUỒN</h6>
                    
                    <!-- Score Badge -->
                    <div class="mb-3">
                        @if (Model.Assessment.ReadinessScore >= 80)
                        {
                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-1.5 rounded-pill"><i class="bi bi-shield-check me-1"></i> Sẵn sàng</span>
                        }
                        else if (Model.Assessment.ReadinessScore >= 50)
                        {
                            <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-3 py-1.5 rounded-pill"><i class="bi bi-exclamation-triangle me-1"></i> Cần cấu thiện</span>
                        }
                        else
                        {
                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-3 py-1.5 rounded-pill"><i class="bi bi-x-circle me-1"></i> Chưa đạt</span>
                        }
                    </div>

                    <div class="health-score-container mb-3" style="display: flex; justify-content: center; align-items: center;">
                        @{
                            string assessColor = Model.Assessment.ReadinessScore >= 80 ? "#10b981" : (Model.Assessment.ReadinessScore >= 50 ? "#f59e0b" : "#ef4444");
                            double assessDegrees = Model.Assessment.ReadinessScore * 3.6;
                        }
                        <div class="health-circle-outer" style="background: conic-gradient(@assessColor 0deg, @assessColor @(assessDegrees)deg, #e2e8f0 @(assessDegrees)deg); width: 100px; height: 100px; display: flex; justify-content: center; align-items: center; border-radius: 50%;">
                            <div class="health-circle-inner" style="background-color: #fff; width: 80px; height: 80px; display: flex; flex-direction: column; justify-content: center; align-items: center; border-radius: 50%;">
                                <span class="health-value text-xl font-bold text-dark" style="font-size: 20px; line-height: 1;">@Model.Assessment.ReadinessScore%</span>
                                <span class="health-label text-xxs tracking-wider mt-1 text-muted" style="font-size: 8px;">Readiness</span>
                            </div>
                        </div>
                    </div>

                    <div class="text-xs text-start px-2 mt-2">
                        <div class="d-flex justify-content-between mb-1" style="font-size: 11px;">
                            <span class="text-muted">Dự án nguồn:</span>
                            <span class="font-semibold text-dark text-truncate ms-2" style="max-width: 100px;" title="@Model.Assessment.ProjectName">@Model.Assessment.ProjectName</span>
                        </div>
                        <div class="d-flex justify-content-between" style="font-size: 11px;">
                            <span class="text-muted">Chiến lược:</span>
                            <span class="badge bg-indigo bg-opacity-10 text-indigo py-0.5 px-1.5 ms-2" style="font-size: 10px;">@Model.Assessment.RecommendedMigrationStrategy</span>
                        </div>
                    </div>
                </div>

                <div class="w-100 px-2 mt-3">
                    <a href="/Assessment" class="btn btn-outline-primary btn-sm w-100" style="border-radius: 8px; font-weight: 600; font-size: 12px; padding: 6px 12px;">
                        <i class="bi bi-search me-1"></i> Chi tiết đánh giá
                    </a>
                </div>
            </div>
        </div>
        <!-- Health Score Card -->
        <div class="col-lg-3 col-md-6">
            <div class="dashboard-card text-center d-flex flex-column align-items-center justify-content-center h-100">
                <h6 class="text-uppercase tracking-wider text-muted font-semibold mb-2" style="font-size: 12px; letter-spacing: 1px;">SỨC KHỎE CHUYỂN ĐỔI</h6>
                
                <!-- Status Badge -->
                <div class="mb-3">
                    @if (Model.MigrationHealthScore >= 75)
                    {
                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-1.5 rounded-pill"><i class="bi bi-shield-check me-1"></i> Ổn định</span>
                    }
                    else if (Model.MigrationHealthScore >= 50)
                    {
                        <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-3 py-1.5 rounded-pill"><i class="bi bi-exclamation-triangle me-1"></i> Cảnh báo</span>
                    }
                    else
                    {
                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-3 py-1.5 rounded-pill"><i class="bi bi-x-octagon me-1"></i> Nguy cấp</span>
                    }
                </div>

                <div class="health-score-container">
                    @{
                        string healthColor = Model.MigrationHealthScore >= 75 ? "#10b981" : (Model.MigrationHealthScore >= 50 ? "#3b82f6" : "#ef4444");
                        double healthDegrees = Model.MigrationHealthScore * 3.6;
                        string healthLabel = Model.MigrationHealthScore >= 75 ? "Đám mây" : (Model.MigrationHealthScore >= 50 ? "Môi trường Lai" : "Nội bộ");
                    }
                    <div class="health-circle-outer" id="healthScoreCircle" style="background: conic-gradient(@healthColor 0deg, @healthColor @(healthDegrees)deg, #e2e8f0 @(healthDegrees)deg);">
                        <div class="health-circle-inner" style="background-color: #fff;">
                            <span class="health-value text-xl font-bold text-dark" id="healthScoreValue" style="font-size: 26px;">@Model.MigrationHealthScore/100</span>
                            <span class="health-label text-xxs tracking-wider mt-1 text-muted" id="healthScoreLabel" style="font-size: 10px;">@healthLabel</span>
                        </div>
                    </div>
                </div>

                <!-- Progress Bar -->
                <div class="w-100 px-3 mt-3">
                    <div class="progress" style="height: 6px; border-radius: 3px;">
                        @{
                            string progressBarColor = Model.MigrationHealthScore >= 75 ? "bg-success" : (Model.MigrationHealthScore >= 50 ? "bg-warning" : "bg-danger");
                        }
                        <div class="progress-bar @progressBarColor" role="progressbar" style="width: @(Model.MigrationHealthScore)%" aria-valuenow="@Model.MigrationHealthScore" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                </div>

                <div class="mt-2 text-muted small" id="healthScoreSub" style="font-size: 11px;">
                    @if (!Model.IsLocalStackAvailable)
                    {
                        <span>LocalStack offline. Trạng thái giả lập.</span>
                    }
                    else
                    {
                        if (Model.MigrationHealthScore >= 75)
                        {
                            <span>Hạ tầng chuyển đổi hoạt động ổn định.</span>
                        }
                        else
                        {
                            <span>Tiến trình chuyển đổi hoàn tất (@Model.MigrationHealthScore%).</span>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Section: Statistics Cards -->
<section id="stats" class="mb-4">
    <div class="row g-4">
        <!-- Card 1: S3 Bucket -->
        <div class="col-xl-3 col-md-6">
            <div class="dashboard-card" id="statCardS3">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    @{
                        string s3IconClass = string.IsNullOrEmpty(Model.S3ErrorMessage) ? "success" : "danger";
                        string s3BadgeClass = string.IsNullOrEmpty(Model.S3ErrorMessage) ? "success" : "danger";
                        string s3BadgeText = string.IsNullOrEmpty(Model.S3ErrorMessage) ? "Hoạt động" : "Lỗi";
                        string s3ValueText = Model.BackupFilesCount > 0 ? $"{Model.BackupFilesCount} tệp" : "0 tệp";
                    }
                    <div class="stat-icon @s3IconClass" id="statIconS3">
                        <i class="bi bi-folder-symlink"></i>
                    </div>
                    <span class="badge bg-@s3BadgeClass bg-opacity-10 text-@s3BadgeClass" id="badgeS3">@s3BadgeText</span>
                </div>
                <h6 class="stat-label">Backup trên S3</h6>
                <h4 class="stat-value" id="valS3">@s3ValueText</h4>
            </div>
        </div>
        <!-- Card 2: DynamoDB Logs -->
        <div class="col-xl-3 col-md-6">
            <div class="dashboard-card" id="statCardDynamo">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    @{
                        string dbIconClass = string.IsNullOrEmpty(Model.DynamoDbErrorMessage) ? "success" : "danger";
                        string dbBadgeClass = string.IsNullOrEmpty(Model.DynamoDbErrorMessage) ? "success" : "danger";
                        string dbBadgeText = string.IsNullOrEmpty(Model.DynamoDbErrorMessage) ? "Sẵn sàng" : "Lỗi";
                        string dbValueText = Model.MigrationLogsCount > 0 ? $"{Model.MigrationLogsCount} nhật ký" : "0 nhật ký";
                    }
                    <div class="stat-icon @dbIconClass" id="statIconDynamo">
                        <i class="bi bi-journal-text"></i>
                    </div>
                    <span class="badge bg-@dbBadgeClass bg-opacity-10 text-@dbBadgeClass" id="badgeDynamo">@dbBadgeText</span>
                </div>
                <h6 class="stat-label">Nhật ký DynamoDB</h6>
                <h4 class="stat-value" id="valDynamo">@dbValueText</h4>
            </div>
        </div>
        <!-- Card 3: Lambda Function -->
        <div class="col-xl-3 col-md-6">
            <div class="dashboard-card" id="statCardLambda">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    @{
                        string lambdaBadgeText = "Chưa chạy";
                        string lambdaBadgeClass = "secondary";
                        if (Model.LatestSelfTestStatus == "Passed") { lambdaBadgeText = "Đạt"; lambdaBadgeClass = "success"; }
                        else if (Model.LatestSelfTestStatus == "Failed") { lambdaBadgeText = "Lỗi"; lambdaBadgeClass = "danger"; }
                        else if (Model.LatestSelfTestStatus == "Running") { lambdaBadgeText = "Đang chạy"; lambdaBadgeClass = "info"; }
                        
                        string lambdaIconClass = lambdaBadgeClass;
                    }
                    <div class="stat-icon @lambdaIconClass" id="statIconLambda">
                        <i class="bi bi-lightning-charge"></i>
                    </div>
                    <span class="badge bg-@lambdaBadgeClass bg-opacity-10 text-@lambdaBadgeClass" id="badgeLambda">@lambdaBadgeText</span>
                </div>
                <h6 class="stat-label">Tự kiểm thử Lambda</h6>
                <h4 class="stat-value" id="valLambda">@lambdaBadgeText</h4>
            </div>
        </div>
        <!-- Card 4: Estimated Cost -->
        <div class="col-xl-3 col-md-6">
            <div class="dashboard-card" id="statCardCost">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="stat-icon success" id="statIconCost">
                        <i class="bi bi-cash-stack"></i>
                    </div>
                    <span class="badge bg-success bg-opacity-10 text-success">Hoạt động</span>
                </div>
                <h6 class="stat-label">Chi phí ước tính</h6>
                <h4 class="stat-value" id="valCost">$@Model.EstimatedMonthlyCost.ToString("F2")/tháng</h4>
            </div>
        </div>
    </div>
</section>

<!-- Section: Migration Center & Cloud Resources -->
<div class="row g-4 mb-4">
    <!-- Migration Center -->
    <div class="col-lg-7" id="migration-center">
        <div class="dashboard-card d-flex flex-column justify-content-between h-100">
            <div>
                <div class="card-header-custom">
                    <h5 class="card-title-custom">
                        <i class="bi bi-play-circle text-primary"></i> Trung tâm chuyển đổi
                    </h5>
                    <div class="d-flex gap-2 flex-wrap">
                        <form asp-controller="Migration" asp-action="Start" method="post" id="migrationForm">
                            <button type="submit" class="btn btn-primary btn-start-migration" id="btnStartMigration" style="padding: 0.5rem 1.25rem; border-radius: 8px; font-weight: 600;">
                                <i class="bi bi-rocket-takeoff me-2"></i> Bắt đầu chuyển đổi
                            </button>
                        </form>
                        <form asp-controller="Restore" asp-action="Start" method="post" id="restoreForm">
                            <button type="submit" class="btn btn-outline-success" id="btnRestoreSimulation" style="padding: 0.5rem 1.25rem; border-radius: 8px; font-weight: 600;">
                                <i class="bi bi-shield-shaded me-2"></i> Mô phỏng khôi phục
                            </button>
                        </form>
                        <form asp-controller="Migration" asp-action="Rollback" method="post" id="rollbackForm">
                            <button type="submit" class="btn btn-outline-danger" id="btnRollbackMigration" style="padding: 0.5rem 1.25rem; border-radius: 8px; font-weight: 600;">
                                <i class="bi bi-arrow-counterclockwise me-2"></i> Hoàn tác di trú (Rollback)
                            </button>
                        </form>
                        <a href="/Monitoring" class="btn btn-outline-primary" style="padding: 0.5rem 1.25rem; border-radius: 8px; font-weight: 600; display: inline-flex; align-items: center;">
                            <i class="bi bi-activity me-2"></i> Giám sát vận hành
                        </a>
                    </div>
                </div>
                
                <!-- Progress Bar -->
                <div class="progress mb-4 d-none" id="migrationProgressContainer" style="height: 8px; border-radius: 4px;">
                    <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary" role="progressbar" style="width: 0%" id="migrationProgressBar"></div>
                </div>

                <!-- Timeline -->
                <div class="timeline" id="migrationTimeline">
                    <div class="timeline-item @(Model.BackupFilesCount > 0 ? "success" : "")" id="timeStep1">
                        <div class="timeline-badge">
                            @if (Model.BackupFilesCount > 0) { <i class="bi bi-check-lg"></i> } else { <i class="bi bi-1-circle-fill"></i> }
                        </div>
                        <div class="timeline-content">
                            <h6 class="timeline-title">Export dữ liệu từ On-premise</h6>
                            <p class="timeline-desc">Kết xuất Database SQL Server thành file backup .bak và đóng gói dữ liệu.</p>
                        </div>
                    </div>
                    <div class="timeline-item @(Model.BackupFilesCount > 0 ? "success" : "")" id="timeStep2">
                        <div class="timeline-badge">
                            @if (Model.BackupFilesCount > 0) { <i class="bi bi-check-lg"></i> } else { <i class="bi bi-2-circle-fill"></i> }
                        </div>
                        <div class="timeline-content">
                            <h6 class="timeline-title">Upload backup lên S3</h6>
                            <p class="timeline-desc">Chuyển tệp dữ liệu lưu trữ vào Amazon S3 Bucket được mô phỏng bởi LocalStack.</p>
                        </div>
                    </div>
                    <div class="timeline-item @(Model.MigrationLogsCount > 2 ? "success" : "")" id="timeStep3">
                        <div class="timeline-badge">
                            @if (Model.MigrationLogsCount > 2) { <i class="bi bi-check-lg"></i> } else { <i class="bi bi-3-circle-fill"></i> }
                        </div>
                        <div class="timeline-content">
                            <h6 class="timeline-title">Ghi migration logs vào DynamoDB</h6>
                            <p class="timeline-desc">Tạo lịch sử chuyển đổi và lưu trạng thái chuyển đổi ứng dụng vào DynamoDB table.</p>
                        </div>
                    </div>
                    <div class="timeline-item @(Model.LatestSelfTestStatus == "Passed" ? "success" : "")" id="timeStep4">
                        <div class="timeline-badge">
                            @if (Model.LatestSelfTestStatus == "Passed") { <i class="bi bi-check-lg"></i> } else { <i class="bi bi-4-circle-fill"></i> }
                        </div>
                        <div class="timeline-content">
                            <h6 class="timeline-title">Chạy Lambda Post-migration Self-test</h6>
                            <p class="timeline-desc">Kích hoạt Lambda function kiểm tra tính toàn vẹn và kết nối dữ liệu sau migration.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Terminal Mock Console -->
            <div class="mt-4">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-xs text-muted font-bold text-uppercase" style="font-size: 11px;"><i class="bi bi-terminal me-1"></i> Nhật ký triển khai</span>
                    <span class="badge bg-dark text-white border border-secondary border-opacity-25 px-2 py-1">Terraform & LocalStack</span>
                </div>
                <div class="console-box" id="migrationConsole">
                    @if (Model.RecentLogs.Any())
                    {
                        <div class="console-line text-success">[INFO] Đã kết nối nhật ký LocalStack... hiển thị các sự kiện gần đây:</div>
                        @foreach (var log in Model.RecentLogs.Take(5))
                        {
                            <div class="console-line">
                                <span class="text-muted">[@log.Timestamp]</span>
                                <span class="c-info">[@log.Status]</span>
                                <span class="text-white">@log.Message</span>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="console-line text-muted">Sẵn sàng chạy mô phỏng. Bấm "Bắt đầu chuyển đổi" ở trên để khởi động...</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Cloud Resources -->
    <div class="col-lg-5" id="cloud-resources">
        <div class="dashboard-card h-100">
            <div class="card-header-custom">
                <h5 class="card-title-custom">
                    <i class="bi bi-hdd-network text-success"></i> Tài nguyên Cloud
                </h5>
                <span class="badge bg-success bg-opacity-10 text-success">LocalStack Endpoint</span>
            </div>
            
            <div class="resource-list mt-3">
                <!-- Resource 1 -->
                <div class="resource-list-item">
                    <div class="resource-info">
                        <div class="resource-icon s3">
                            <i class="bi bi-archive-fill"></i>
                        </div>
                        <div>
                            <div class="resource-name">S3 Bucket</div>
                            <div class="resource-type">Lưu trữ sao lưu</div>
                        </div>
                    </div>
                    <div class="resource-value" data-bs-toggle="tooltip" title="@Model.S3BucketName">@Model.S3BucketName</div>
                </div>
                @if (!string.IsNullOrEmpty(Model.S3ErrorMessage))
                {
                    <div class="text-danger text-xs px-3 mb-2" style="font-size: 11px;"><i class="bi bi-exclamation-circle-fill me-1"></i> @Model.S3ErrorMessage</div>
                }
                
                <!-- Resource 2 -->
                <div class="resource-list-item">
                    <div class="resource-info">
                        <div class="resource-icon dynamodb">
                            <i class="bi bi-database-fill-gear"></i>
                        </div>
                        <div>
                            <div class="resource-name">Bảng DynamoDB</div>
                            <div class="resource-type">Cơ sở dữ liệu nhật ký</div>
                        </div>
                    </div>
                    <div class="resource-value" data-bs-toggle="tooltip" title="@Model.DynamoDbTableName">@Model.DynamoDbTableName</div>
                </div>
                @if (!string.IsNullOrEmpty(Model.DynamoDbErrorMessage))
                {
                    <div class="text-danger text-xs px-3 mb-2" style="font-size: 11px;"><i class="bi bi-exclamation-circle-fill me-1"></i> @Model.DynamoDbErrorMessage</div>
                }
                
                <!-- Resource 3 -->
                <div class="resource-list-item">
                    <div class="resource-info">
                        <div class="resource-icon lambda">
                            <i class="bi bi-cpu-fill"></i>
                        </div>
                        <div>
                            <div class="resource-name">Hàm Lambda</div>
                            <div class="resource-type">Tự kiểm thử Serverless</div>
                        </div>
                    </div>
                    <div class="resource-value" data-bs-toggle="tooltip" title="@Model.LambdaFunctionName">@Model.LambdaFunctionName</div>
                </div>
                @if (!string.IsNullOrEmpty(Model.LambdaErrorMessage))
                {
                    <div class="text-danger text-xs px-3 mb-2" style="font-size: 11px;"><i class="bi bi-exclamation-circle-fill me-1"></i> @Model.LambdaErrorMessage</div>
                }
                
                <!-- Resource 4 -->
                <div class="resource-list-item">
                    <div class="resource-info">
                        <div class="resource-icon iam">
                            <i class="bi bi-shield-lock-fill"></i>
                        </div>
                        <div>
                            <div class="resource-name">IAM Roles & Policies</div>
                            <div class="resource-type">Quản lý truy cập</div>
                        </div>
                    </div>
                    <div class="resource-value" data-bs-toggle="tooltip" title="least privilege model">Quyền hạn tối thiểu</div>
                </div>
            </div>

            <!-- Additional Detail/LocalStack Port Info -->
            <div class="mt-4 p-3 bg-light rounded-3 border border-dashed border-secondary border-opacity-25">
                <h6 class="text-xs text-muted font-bold text-uppercase mb-2" style="font-size: 11px;"><i class="bi bi-info-circle me-1 text-primary"></i> Ánh xạ LocalStack cục bộ</h6>
                <div class="d-flex justify-content-between text-xs mb-1">
                    <span class="text-muted">Edge Port:</span>
                    <span class="font-monospace text-dark font-semibold">localhost:4566</span>
                </div>
                <div class="d-flex justify-content-between text-xs mb-1">
                    <span class="text-muted">Trạng thái Terraform:</span>
                    <span class="font-monospace text-success font-semibold">localstack.tfstate</span>
                </div>
                <div class="d-flex justify-content-between text-xs mb-1">
                    <span class="text-muted">Cơ sở dữ liệu SQL:</span>
                    <span class="font-monospace text-primary font-semibold">On-Prem (Cổng 1433)</span>
                </div>
                <div class="d-flex justify-content-between text-xs mb-1 pt-2 border-top border-secondary border-opacity-10 mt-2">
                    <span class="text-muted">Gói di trú gần nhất:</span>
                    <span class="font-monospace text-dark font-semibold text-truncate ms-2" style="max-width: 140px;" title="@Model.LatestMigrationId">@Model.LatestMigrationId</span>
                </div>
                <div class="d-flex justify-content-between text-xs">
                    <span class="text-muted">Khôi phục thảm họa (DR):</span>
                    @{
                        string restoreBadgeColor = "secondary";
                        if (Model.LatestRestoreStatus == "Completed") restoreBadgeColor = "success";
                        else if (Model.LatestRestoreStatus == "Warning") restoreBadgeColor = "warning text-dark";
                        else if (Model.LatestRestoreStatus == "Failed") restoreBadgeColor = "danger";
                        else if (Model.LatestRestoreStatus == "Running") restoreBadgeColor = "info";
                    }
                    <span class="badge bg-@restoreBadgeColor bg-opacity-15 text-@restoreBadgeColor font-semibold px-1.5 py-0.5" style="font-size: 9px; border-radius: 4px;">@Model.LatestRestoreStatus</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Section: Live Cloud Resource Backups & Logs Tables -->
<div class="row g-4 mb-4">
    <!-- S3 Backups Table -->
    <div class="col-lg-6">
        <div class="dashboard-card">
            <div class="card-header-custom border-bottom pb-2">
                <h5 class="card-title-custom text-warning">
                    <i class="bi bi-file-earmark-zip-fill"></i> Backup gần đây trên S3
                </h5>
                <span class="badge bg-warning bg-opacity-10 text-warning">@Model.BackupFilesCount tệp</span>
            </div>
            <div class="table-responsive mt-3" style="max-height: 280px; overflow-y: auto;">
                <table class="table table-hover align-middle mb-0 text-sm">
                    <thead class="table-light sticky-top">
                        <tr>
                            <th>Tên đối tượng (Key)</th>
                            <th>Dung lượng</th>
                            <th>Thời gian</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentBackups.Any())
                        {
                            @foreach (var backup in Model.RecentBackups.Take(10))
                            {
                                <tr>
                                    <td class="font-monospace text-xs text-dark font-semibold">
                                        <div class="d-flex align-items-center gap-2">
                                            @{
                                                string key = backup.Key;
                                                string fileName = System.IO.Path.GetFileName(key);
                                                string badgeColor = "secondary";
                                                string fileTypeLabel = "Dữ liệu";
                                                string fileIcon = "bi-file-earmark";

                                                if (fileName.EndsWith(".zip"))
                                                {
                                                    badgeColor = "warning text-dark";
                                                    fileTypeLabel = "Source ZIP";
                                                    fileIcon = "bi-file-earmark-zip-fill";
                                                }
                                                else if (fileName == "migration-report.html")
                                                {
                                                    badgeColor = "danger";
                                                    fileTypeLabel = "Report HTML";
                                                    fileIcon = "bi-file-earmark-richtext-fill";
                                                }
                                                else if (fileName == "migration-report.json")
                                                {
                                                    badgeColor = "success";
                                                    fileTypeLabel = "Report JSON";
                                                    fileIcon = "bi-file-earmark-code-fill";
                                                }
                                                else if (fileName == "assessment-report.json")
                                                {
                                                    badgeColor = "info text-dark";
                                                    fileTypeLabel = "Assessment";
                                                    fileIcon = "bi-clipboard-data-fill";
                                                }
                                                else if (fileName == "migration-manifest.json")
                                                {
                                                    badgeColor = "primary";
                                                    fileTypeLabel = "Manifest";
                                                    fileIcon = "bi-file-earmark-text-fill";
                                                }
                                                else if (key.StartsWith("backups/") && key.EndsWith(".json"))
                                                {
                                                    badgeColor = "secondary";
                                                    fileTypeLabel = "Legacy Backup";
                                                    fileIcon = "bi-file-earmark-arrow-up-fill";
                                                }
                                            }
                                            <i class="bi @fileIcon text-secondary fs-6"></i>
                                            <div class="text-truncate" style="max-width: 180px;" title="@backup.Key">@fileName</div>
                                            <span class="badge bg-@badgeColor bg-opacity-10 text-@badgeColor" style="font-size: 8px; padding: 2px 4px;">@fileTypeLabel</span>
                                        </div>
                                        <div class="text-xxs text-muted font-monospace mt-0.5" style="font-size: 9px; max-width: 320px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="@backup.Key">@backup.Key</div>
                                    </td>
                                    <td>
                                        @if (backup.Size >= 1048576)
                                        {
                                            <span>@((backup.Size / 1048576.0).ToString("F2")) MB</span>
                                        }
                                        else
                                        {
                                            <span>@((backup.Size / 1024.0).ToString("F1")) KB</span>
                                        }
                                    </td>
                                    <td class="text-muted text-xs">@backup.LastModified.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center text-muted py-4">
                                    <i class="bi bi-folder2-open d-block fs-3 mb-2 text-secondary"></i>
                                    Không tìm thấy tệp sao lưu nào trong S3 bucket.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- DynamoDB Logs Table -->
    <div class="col-lg-6">
        <div class="dashboard-card">
            <div class="card-header-custom border-bottom pb-2">
                <h5 class="card-title-custom text-primary">
                    <i class="bi bi-database-fill"></i> Nhật ký chuyển đổi gần đây
                </h5>
                <span class="badge bg-primary bg-opacity-10 text-primary">@Model.MigrationLogsCount nhật ký</span>
            </div>
            <div class="table-responsive mt-3" style="max-height: 280px; overflow-y: auto;">
                <table class="table table-hover align-middle mb-0 text-sm">
                    <thead class="table-light sticky-top">
                        <tr>
                            <th>Mã chuyển đổi</th>
                            <th>Trạng thái</th>
                            <th>Thông báo</th>
                            <th>Thời gian</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentLogs.Any())
                        {
                            @foreach (var log in Model.RecentLogs.Take(5))
                            {
                                <tr>
                                    <td class="font-monospace text-xs text-primary font-semibold">
                                        <div class="text-truncate" style="max-width: 110px;" title="@log.MigrationId">@log.MigrationId</div>
                                    </td>
                                    <td>
                                        @{
                                            string statusText = log.Status;
                                            string badgeColor = "secondary";
                                            if (log.Status == "SELF_TEST_PASSED") { statusText = "Tự kiểm thử đạt"; badgeColor = "success"; }
                                            else if (log.Status == "ROLLBACK_COMPLETED") { statusText = "Khôi phục hoàn tất"; badgeColor = "info"; }
                                            else if (log.Status == "UPLOADED_TO_S3") { statusText = "Đã tải lên S3"; badgeColor = "primary"; }
                                            else if (log.Status == "BACKUP_CREATED") { statusText = "Đã tạo backup"; badgeColor = "warning text-dark"; }
                                            else if (log.Status == "STARTED") { statusText = "Đã bắt đầu"; badgeColor = "secondary"; }
                                            else if (log.Status == "FAILED") { statusText = "Lỗi"; badgeColor = "danger"; }
                                            else if (log.Status == "ROLLBACK_STARTED") { statusText = "Bắt đầu khôi phục"; badgeColor = "warning text-dark"; }
                                            else if (log.Status == "SELF_TEST_TRIGGERED") { statusText = "Đang tự kiểm thử"; badgeColor = "info"; }
                                        }
                                        <span class="badge bg-@badgeColor bg-opacity-10 text-@badgeColor text-xs">@statusText</span>
                                    </td>
                                    <td class="text-xs text-dark" style="max-width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="@log.Message">
                                        @log.Message
                                    </td>
                                    <td class="text-muted text-xs">@log.Timestamp</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">
                                    <i class="bi bi-journal-x d-block fs-3 mb-2 text-secondary"></i>
                                    Không tìm thấy nhật ký chuyển đổi nào trong DynamoDB.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Section: Cost Estimation & Architecture -->
<div class="row g-4 mb-4">
    <!-- Cost Estimation -->
    <div class="col-lg-5" id="cost-estimation">
        <div class="dashboard-card h-100 d-flex flex-column justify-content-between">
            <div>
                <div class="card-header-custom">
                    <h5 class="card-title-custom">
                        <i class="bi bi-currency-dollar text-warning"></i> Ước tính chi phí
                    </h5>
                    <span class="badge bg-warning bg-opacity-10 text-warning" id="costTotalBadge">$@Model.EstimatedMonthlyCost.ToString("F2") / tháng</span>
                </div>
                
                <div class="chart-container-custom d-flex align-items-center justify-content-center mt-3" style="height: 260px;">
                    <canvas id="costChart"></canvas>
                </div>

                <div class="table-responsive mt-3 text-xs">
                    <table class="table table-sm table-borderless align-middle mb-0">
