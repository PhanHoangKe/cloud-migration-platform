<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EduCourse Sample (On-Premises Demo App)</title>
    
    <!-- Modern Typography: Google Fonts Outfit & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    
    <!-- Custom Modern Styling Override -->
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc;
            color: #1e293b;
        }
        h1, h2, h3, h4, h5, h6, .display-font {
            font-family: 'Outfit', sans-serif;
            font-weight: 700;
        }
        .navbar-custom {
            background: linear-gradient(135deg, #1e1b4b 0%, #312e81 100%);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
        }
        .navbar-custom .navbar-brand {
            font-family: 'Outfit', sans-serif;
            font-weight: 800;
            color: #ffffff !important;
            letter-spacing: -0.5px;
        }
        .navbar-custom .nav-link {
            color: #e2e8f0 !important;
            font-weight: 500;
            padding: 0.5rem 1rem !important;
            border-radius: 0.375rem;
            transition: all 0.2s ease;
        }
        .navbar-custom .nav-link:hover, .navbar-custom .nav-link.active {
            color: #ffffff !important;
            background-color: rgba(255, 255, 255, 0.1);
        }
        .footer-custom {
            background-color: #0f172a;
            color: #94a3b8;
            border-top: 1px solid #1e293b;
            padding: 2rem 0;
            margin-top: 4rem;
        }
        .footer-custom a {
            color: #38bdf8;
            text-decoration: none;
            transition: color 0.15s ease;
        }
        .footer-custom a:hover {
            color: #7dd3fc;
        }
        .badge-migration-tag {
            background: linear-gradient(90deg, #f59e0b 0%, #d97706 100%);
            color: #ffffff;
            font-size: 0.75rem;
            font-weight: 600;
            padding: 0.35em 0.65em;
            border-radius: 50rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom mb-4">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <span class="me-2">🎓</span> EduCourse <span class="text-info ms-1">Sample</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Trang Chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Courses" asp-action="Index">Khóa Học</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Lessons" asp-action="Index">Bài Học & Tài Liệu</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Students" asp-action="Index">Học Viên</a>
                        </li>
                    </ul>
                    <div class="d-flex">
                        <span class="badge badge-migration-tag d-flex align-items-center">
                            📡 Source: On-Premises
                        </span>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container flex-grow-1">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-custom">
        <div class="container text-center">
            <p class="mb-2"><strong>EduCourse Sample Application</strong> - Hệ thống mô phỏng chuyển đổi ứng dụng từ On-Premises lên Cloud</p>
            <p class="mb-0 text-muted" style="font-size: 0.875rem;">
                &copy; @DateTime.Now.Year - Đồ án Cloud Computing | Sử dụng LocalStack & Terraform
            </p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
